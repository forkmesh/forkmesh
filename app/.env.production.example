# Copy to .env.production. The destination is ignored by Git.
# CLOUDFLARE_* and VULTR_* configure deployment tooling; other values are
# published atomically as Worker secrets by deploy.sh.

CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_OBSERVABILITY_API_TOKEN=
# WORKERS_OBSERVABILITY_SERVICE=forkmesh-app
# VULTR_API_KEY=

# Must start with admin-. Access still requires an administrator account.
ADMIN_PATH=admin-CHANGE-ME-TO-SOMETHING-RANDOM
ADMIN_PASS=CHANGE-ME-TO-A-LONG-RANDOM-VALUE
# Internal product dashboard (/product-analysis). Leave both unset to keep the
# route answering 404; set both to open it with exactly this username and
# password. Never ship a placeholder here: it would be a working password.
# PRODUCT_ANALYSIS_USER=
# PRODUCT_ANALYSIS_PASS=

# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# Rotating DATA_KEY makes existing encrypted rows unreadable.
DATA_KEY=CHANGE-ME-RUN-THE-GENERATOR-ABOVE

# Apple Push Notification service authentication. Keep all three values in
# .env.production so deploy.sh publishes them as Worker secrets.
# The Key ID and Team ID are each exactly ten characters of A-Z0-9 (the Key ID
# is the XXXXXXXXXX in AuthKey_XXXXXXXXXX.p8). Any other shape is refused by
# Apple on every push, and deploy.sh warns about it.
# APNS_AUTH_KEY=base64-or-single-line-p8-key
# APNS_KEY_ID=YOUR-10-CHARACTER-KEY-ID
# APNS_TEAM_ID=YOUR-10-CHARACTER-TEAM-ID

# Base64url Ed25519 public key and matching 32-byte seed for mirror routing.
# Generate them with the operations/direct-https-mirror-gateway.md recipe.
# Rotate only with: ./deploy.sh rotate-mirror-router
MIRROR_ROUTER_PUBLIC_KEY=CHANGE-ME-BASE64URL-32-BYTE-PUBLIC-KEY
MIRROR_ROUTER_SIGNING_SEED=CHANGE-ME-BASE64URL-32-BYTE-SEED

TREASURY_SOLANA_ADDRESS=CHANGE-ME-PUBLIC-MAINNET-ADDRESS
# COMMUNITY_REWARD_POOL_ADDRESS=
# REWARD_SIGNER_ACCOUNT=

# Optional independently operated Git SSH gateway.
# SSH_GATEWAY_HOST=ssh.forkmesh.com
# SSH_GATEWAY_PORT=22
# SSH_GATEWAY_TOKEN=
# SSH_GATEWAY_REPOSITORIES=alice-node/widget=read-write
# SSH_GATEWAY_NODE_HOSTS=alice-node=ssh-alice.example.org

MAILTRAP_API_TOKEN=CHANGE-ME
MAILTRAP_WEBHOOK_SECRET=CHANGE-ME
# Register: https://app.forkmesh.com/api/integrations/mailtrap/webhook
# In Mailtrap, use the Transactional stream for that webhook and select
# delivery, bounce, soft bounce, spam, unsubscribe, suspension, and reject.
# Open/click events require Mailtrap engagement tracking on a paid plan and are
# optional telemetry only. ForkMesh never treats them as email verification or
# referral-eligibility evidence; the recipient's one-use confirmation POST is
# distinct from a separately audited administrator override for a stranded
# address.
# MAILTRAP_SENDER=founders@forkmesh.com
# MAILTRAP_SENDER_NAME=ForkMesh
# MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send

# Patreon membership OAuth + webhook. ForkMesh treats Patreon as the payment
# rail for the Pro plan ($10/mo) and for supporter badges ($5 / $50 / $100); no
# card data ever touches the Worker. Production deploys require the five secrets
# below (validated by deploy.sh before any migration or Worker upload) and
# publish them in the same atomic secret bulk update as Discord credentials.
# Never paste client secrets, webhook secrets, or creator tokens into source,
# D1, ForkMesh tasks, dashboards, logs, or chat. OAuth access/refresh tokens
# from member Connect flows are discarded immediately and must never be stored.
#
# Create the OAuth client + webhook in the Patreon developer portal. Scopes:
#   identity, identity[email], identity.memberships
# Exact callback URI (also committed in wrangler.toml [vars]):
#   https://forkmesh.com/api/integrations/patreon/callback
# Webhook URL:
#   https://forkmesh.com/api/integrations/patreon/webhook
# Events: members:pledge:create, members:pledge:update, members:pledge:delete.
# Signature: hex HMAC-MD5 of the exact raw body (X-Patreon-Signature).
# Operator runbook: ../www/docs/operations/patreon.md
PATREON_CLIENT_ID=CHANGE-ME
PATREON_CLIENT_SECRET=CHANGE-ME
PATREON_WEBHOOK_SECRET=CHANGE-ME
# Numeric campaign ID whose memberships ForkMesh may reconcile. This is not the
# campaign URL or vanity slug.
PATREON_CAMPAIGN_ID=CHANGE-ME
# Creator-scoped Patreon credential used only for bounded GET requests to the
# fixed /api/oauth2/v2/members/{id} endpoint. Never use or paste a patron's
# OAuth access/refresh token here.
PATREON_CREATOR_ACCESS_TOKEN=CHANGE-ME
# The non-secret callback URL lives in wrangler.toml [vars]:
#   PATREON_OAUTH_REDIRECT_URI=https://forkmesh.com/api/integrations/patreon/callback

DISCORD_CLIENT_ID=CHANGE-ME-17-TO-20-DIGIT-APPLICATION-ID
DISCORD_CLIENT_SECRET=CHANGE-ME-ROTATE-IN-DISCORD-DEVELOPER-PORTAL
DISCORD_BOT_TOKEN=CHANGE-ME-ROTATE-IN-DISCORD-DEVELOPER-PORTAL
PACKAGE_CRM_ZOHO_OAUTH_CLIENT_ID=
PACKAGE_CRM_ZOHO_OAUTH_CLIENT_SECRET=
PACKAGE_CRM_ZOHO_OAUTH_REDIRECT_URI=https://app.forkmesh.com/api/crm/-/zoho/callback
# Register: https://app.forkmesh.com/api/integrations/discord/callback

# X_API_BEARER_TOKEN=
# SENTRY_DSN=https://PUBLIC_KEY@o000000.ingest.sentry.io/000000
# SENTRY_CRON_MONITOR_SLUG=forkmesh-relay
# SENTRY_CRON_CHECKIN_MARGIN_MINUTES=1
# SENTRY_CRON_MAX_RUNTIME_MINUTES=5
# SENTRY_CRON_TIMEZONE=UTC
