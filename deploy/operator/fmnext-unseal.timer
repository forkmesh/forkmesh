# systemd --user timer for the operator box (NOT installed automatically).
#   install -m 0644 deploy/operator/fmnext-unseal.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now fmnext-unseal.timer
# While this desktop is off, a node that restarts stays sealed (503) until
# the timer runs again: see docs/VAULT.md "Availability".
[Unit]
Description=Unseal sealed ForkMesh Next core nodes every minute

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
