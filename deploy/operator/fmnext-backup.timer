# systemd --user timer for the operator box (NOT installed automatically).
#   install -m 0644 deploy/operator/fmnext-backup.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now fmnext-backup.timer
[Unit]
Description=Nightly ForkMesh Next rqlite backup

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
