# Managed by deploy/core/render.py for node n2 (role core).
# Based on server/packaging/systemd/forkmesh-mirror-node.service.
[Unit]
Description=ForkMesh Next daemon (role core, node n2)
Wants=network-online.target
After=network-online.target forkmesh-app.service caddy.service

[Service]
Type=simple
User=forkmesh-node
Group=forkmesh-node
# No journal-reader group: the daemon never reads the journal.
# Owner-only files: the node key, connector token and state are never
# readable by another local uid (the runner's job user included).
UMask=0077
Environment=TZ=UTC
Environment=HOME=/var/lib/forkmesh
Environment=XDG_DATA_HOME=/var/lib/forkmesh/.local/share
Environment=TMPDIR=/var/lib/forkmesh/tmp
EnvironmentFile=-/etc/forkmesh/node.env
ExecStartPre=-/usr/bin/python3 -I /usr/local/share/forkmesh/tools/mirror_gateway.py --cleanup-runtime /var/lib/forkmesh/tmp
ExecStartPre=/usr/local/bin/forkmesh-mirror-node --config /etc/forkmesh/mirror-node.json --check
ExecStart=/usr/local/bin/forkmesh-mirror-node --config /etc/forkmesh/mirror-node.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
MemoryHigh=96M
MemoryMax=128M
OOMScoreAdjust=200
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/forkmesh
# The cloud metadata service (instance secrets, user-data) is never needed.
IPAddressDeny=169.254.0.0/16
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
TasksMax=128
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
