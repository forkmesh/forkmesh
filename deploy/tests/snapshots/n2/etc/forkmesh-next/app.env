# Managed by deploy/core/render.py for node n2. Not secret: secrets are
# systemd credentials (/etc/forkmesh-next/creds/*.cred).
FORKMESH_PLATFORM=vps
FORKMESH_NODE_ID=n2
FORKMESH_MESH_LISTEN=10.77.0.2:8792
FORKMESH_MESH_URL=http://10.77.0.2:8792
FORKMESH_RQLITE_NODE_MAP=n1=n1,n2=n2,n3=n3
FORKMESH_HOST_DB=rqlite:http://127.0.0.1:4001
FORKMESH_HOST_DATA_DIR=/var/lib/forkmesh-next/app
FORKMESH_REQUEST_RULES_FILE=/var/lib/forkmesh-next/app/request-rules.json
FORKMESH_HOST_ASSETS_DIR=/opt/forkmesh-next/app/current/app/dist
RQLITE_USERNAME=fmnext
RQLITE_READ_MODE=http
RQLITE_DB_PATH=/var/lib/forkmesh-next/rqlite/db.sqlite
FORKMESH_HOST_D1_LOG=1
# The only Host names the App answers to (asgi.py rejects any other).
FORKMESH_PUBLIC_HOSTS=app.next.forkmesh.com,world.next.forkmesh.com,n1.next.forkmesh.com,n2.next.forkmesh.com,n3.next.forkmesh.com
FORKMESH_VAR_RUNNER_SSH_HELPER_SOCKET=/run/fmnext-ssh-helper.sock
# Static mesh addresses (node -> WireGuard URL); cluster.py never takes an
# address from the database.
FORKMESH_MESH_PEERS=n1=http://10.77.0.1:8792,n2=http://10.77.0.2:8792,n3=http://10.77.0.3:8792
# Leaderless DNS health for app.next/world.next (dns_reconciler.py).
FORKMESH_DNS_RECONCILER=dry
FORKMESH_DNS_TARGETS=n1=203.0.113.11,n2=203.0.113.12,n3=203.0.113.13
FORKMESH_DNS_NAMES=app.next.forkmesh.com,world.next.forkmesh.com
# Intrusion detection (docs/IDS.md): the core IDS public keys and
# the operator release key; quarantine rows are verified with them.
FORKMESH_IDS_PUBKEYS=
FORKMESH_IDS_OPERATOR_PUBKEY=
