# Managed by deploy/core/render.py for node @@NODE@@ (role @@ROLE@@).
# Based on server/packaging/systemd/forkmesh-mirror-node.service.
[Unit]
Description=ForkMesh Next daemon (role @@ROLE@@, node @@NODE@@)
Wants=network-online.target
After=network-online.target @@DAEMON_AFTER@@

[Service]
Type=simple
User=@@DAEMON_USER@@
Group=@@DAEMON_USER@@
# No journal-reader group: the daemon never reads the journal.
# Owner-only files: the node key, connector token and state are never
# readable by another local uid (the runner's job user included).
UMask=0077
Environment=TZ=UTC
Environment=HOME=/var/lib/forkmesh
Environment=XDG_DATA_HOME=/var/lib/forkmesh/.local/share
Environment=TMPDIR=/var/lib/forkmesh/tmp
EnvironmentFile=-/etc/forkmesh/node.env
ExecStartPre=-/usr/bin/python3 -I /usr/local/share/forkmesh/tools/mirror_gateway.py --cleanup-runtime /var/lib/forkmesh/tmp
ExecStartPre=/usr/local/bin/forkmesh-mirror-node --config /etc/forkmesh/mirror-node.json --check
ExecStart=/usr/local/bin/forkmesh-mirror-node --config /etc/forkmesh/mirror-node.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
@@DAEMON_LIMITS@@
NoNewPrivileges=true
PrivateDevices=true
@@DAEMON_TMP@@
ProtectClock=true
ProtectControlGroups=true
ProtectHome=@@PROTECT_HOME@@
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=@@DAEMON_RW@@
# The cloud metadata service (instance secrets, user-data) is never needed.
IPAddressDeny=169.254.0.0/16
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
CapabilityBoundingSet=@@DAEMON_CAPS@@
AmbientCapabilities=@@DAEMON_AMBIENT@@
SystemCallArchitectures=native
TasksMax=128
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
