# Managed by deploy/core/render.py for node @@NODE@@. Not secret: secrets are
# systemd credentials (@@CREDS@@/*.cred).
FORKMESH_PLATFORM=vps
FORKMESH_NODE_ID=@@NODE@@
FORKMESH_MESH_LISTEN=@@WG_IP@@:@@MESH_PORT@@
FORKMESH_MESH_URL=http://@@WG_IP@@:@@MESH_PORT@@
FORKMESH_RQLITE_NODE_MAP=@@RQLITE_NODE_MAP@@
FORKMESH_HOST_DB=rqlite:http://127.0.0.1:@@HTTP_PORT@@
FORKMESH_HOST_DATA_DIR=@@VAR@@/app
FORKMESH_REQUEST_RULES_FILE=@@REQUEST_RULES_EXPORT@@
FORKMESH_HOST_ASSETS_DIR=@@CURRENT@@/app/dist
RQLITE_USERNAME=@@RQLITE_USER@@
RQLITE_READ_MODE=@@READ_MODE@@
RQLITE_DB_PATH=@@DATA_DIR@@/db.sqlite
FORKMESH_HOST_D1_LOG=@@D1_LOG@@
# The only Host names the App answers to (asgi.py rejects any other).
FORKMESH_PUBLIC_HOSTS=@@PUBLIC_HOSTS@@
FORKMESH_VAR_RUNNER_SSH_HELPER_SOCKET=@@SSH_HELPER_SOCKET@@
# Static mesh addresses (node -> WireGuard URL); cluster.py never takes an
# address from the database.
FORKMESH_MESH_PEERS=@@MESH_PEERS@@
# Leaderless DNS health for app.next/world.next (dns_reconciler.py).
@@DNS_SETTINGS@@
FORKMESH_MAIL_SENDERS=@@MAIL_SENDERS@@
@@IDS_SETTINGS@@@@PRODUCTION_SETTINGS@@@@TURN_SETTINGS@@@@CALLS_SETTINGS@@
