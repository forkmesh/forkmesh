# Managed by deploy/core/render.py for node @@NODE@@. Do not edit on the node.
[Unit]
Description=rqlite for ForkMesh Next (node @@NODE@@)
Documentation=https://rqlite.io/docs/
Wants=network-online.target wg-quick@wg0.service
After=network-online.target wg-quick@wg0.service

[Service]
Type=simple
User=rqlite
Group=rqlite
# 0027: the app user (in group rqlite) may read db.sqlite for local reads.
UMask=0027
# rqlite rewrites 'now' with the host's local clock (app/host/RQLITE_FINDINGS.md).
Environment=TZ=UTC
Environment=GOMEMLIMIT=@@GOMEMLIMIT@@
# Basic-auth users (built from RQLITE_PASSWORD on the operator box); %d is
# this unit's credentials directory.
LoadCredentialEncrypted=rqlite-auth.json:@@CREDS@@/rqlite-auth.json.cred
ExecStart=/usr/local/bin/rqlited \
  -node-id @@RQLITE_ID@@ \
  -http-addr 127.0.0.1:@@HTTP_PORT@@ \
  -raft-addr @@WG_IP@@:@@RAFT_PORT@@ \
  -auth %d/rqlite-auth.json \
  -join-as @@RQLITE_USER@@ \
@@JOIN_FLAGS@@  @@DATA_DIR@@
Restart=always
RestartSec=2s
TimeoutStopSec=30s
OOMScoreAdjust=-800
MemoryMax=220M
LimitNOFILE=65536
# Database pages never reach the swapfile or zram.
MemorySwapMax=0
IPAddressDeny=169.254.0.0/16
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@@DATA_DIR@@
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
