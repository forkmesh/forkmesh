{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forkmesh.com/schemas/marketplace-agent-v1.json",
  "title": "ForkMesh marketplace local-agent descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provider",
    "runtime",
    "endpoint",
    "defaultModel",
    "avatar",
    "documentation",
    "runtimeDownload",
    "models"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "provider": { "const": "local-llama" },
    "runtime": { "const": "ollama" },
    "endpoint": {
      "type": "string",
      "pattern": "^http://(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::[0-9]{1,5})?/v1/chat/completions$"
    },
    "defaultModel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "avatar": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "documentation": { "type": "string", "format": "uri" },
    "runtimeDownload": { "type": "string", "format": "uri" },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "downloadBytes", "contextTokens"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "downloadBytes": { "type": "integer", "minimum": 1 },
          "contextTokens": { "type": "integer", "minimum": 1024 }
        }
      }
    }
  }
}
