{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "desktops",
  "name": "Desktops",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Operate",
  "version": "1.0.0",
  "summary": "Desktops: see and drive your ForkMesh desktops from the phone, with their terminals and screens.",
  "screenshots": [
    {
      "path": "preview/market.svg",
      "alt": "The Desktops plugin card"
    }
  ],
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": {
    "amount": 0,
    "currency": "USD"
  },
  "entrypoints": {
    "ios": "builtin:desktops",
    "android": "builtin:desktops",
    "settings": "builtin:package"
  },
  "permissions": [
    {
      "id": "desktop.remote",
      "label": "Connect to your own ForkMesh desktops and run commands on them",
      "risk": "high"
    }
  ],
  "dependencies": [],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": false,
    "signature": "verified-bundle"
  },
  "install": {
    "bundled": true,
    "default": false,
    "sync": "account",
    "installedBefore": "2026-10-11"
  },
  "lifecycle": {
    "migrations": []
  },
  "dataLifecycle": {
    "scope": "none",
    "localData": false
  }
}
