{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "workflows-pack-developer-tools",
  "name": "Workflows: Developer tools",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Workflow add-ons",
  "version": "1.0.0",
  "summary": "Adds 13 developer tools integrations to Workflows: GitHub, GitLab, Bitbucket, Jira and more.",
  "screenshots": [
    {
      "path": "preview/market.svg",
      "alt": "Workflows: Developer tools"
    }
  ],
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": {
    "amount": 0,
    "currency": "USD"
  },
  "entrypoints": {
    "pack": "content/pack.json",
    "settings": "builtin:package"
  },
  "contributions": [
    {
      "socket": "workflows.integrations",
      "entrypoint": "pack",
      "config": {
        "category": "Developer tools",
        "integrations": [
          "github",
          "gitlab",
          "bitbucket",
          "jira",
          "linear",
          "sentry",
          "pagerduty",
          "opsgenie",
          "circleci",
          "netlify",
          "vercel",
          "cloudflare",
          "digitalocean"
        ]
      }
    }
  ],
  "permissions": [
    {
      "id": "network.workflows.outbound",
      "label": "Let workflow steps call developer tools services you connect",
      "risk": "high"
    }
  ],
  "dependencies": [
    {
      "id": "workflows",
      "version": "^1.0.0"
    }
  ],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": true,
    "signature": "verified-bundle"
  },
  "install": {
    "bundled": true,
    "default": true,
    "sync": "account"
  },
  "lifecycle": {
    "migrations": []
  },
  "dataLifecycle": {
    "scope": "none",
    "localData": false
  }
}
