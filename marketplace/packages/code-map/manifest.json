{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "code-map",
  "name": "Code Map",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Repositories",
  "version": "1.0.0",
  "summary": "The repository screen's Code map: the whole codebase at the browsed branch as a zoomable treemap with each file's source drawn in its cell, or a rotatable 3D city.",
  "screenshots": [
    {
      "path": "preview/market.webp",
      "alt": "The Code Map plugin card: a treemap of a repository's folders and files"
    }
  ],
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": {
    "amount": 0,
    "currency": "USD"
  },
  "entrypoints": {
    "desktop": "builtin:code-map",
    "settings": "builtin:package"
  },
  "permissions": [
    {
      "id": "repository.read",
      "label": "Read the files of the repository you open at the browsed branch",
      "risk": "low"
    }
  ],
  "dependencies": [],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": false,
    "signature": "verified-bundle"
  },
  "install": {
    "bundled": true,
    "default": false,
    "installedBefore": "2026-10-17"
  },
  "lifecycle": {
    "migrations": []
  },
  "dataLifecycle": {
    "scope": "none",
    "localData": false
  }
}
