{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "pull-requests",
  "name": "Pull requests",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Repositories",
  "version": "1.0.0",
  "summary": "The Pull requests tab of every repository: open, review, comment on and merge pull requests. Needs Branches.",
  "screenshots": [
    {
      "path": "preview/market.svg",
      "alt": "The Pull requests plugin card"
    }
  ],
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": {
    "amount": 0,
    "currency": "USD"
  },
  "entrypoints": {
    "desktop": "builtin:pull-requests",
    "ios": "builtin:pull-requests",
    "android": "builtin:pull-requests",
    "web": "builtin:pull-requests",
    "settings": "builtin:package"
  },
  "permissions": [
    {
      "id": "repository.pulls",
      "label": "Read, review and merge pull requests on repositories you can access",
      "risk": "sensitive"
    }
  ],
  "dependencies": [
    {
      "id": "branches",
      "version": "^1.0.0"
    }
  ],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": false,
    "signature": "verified-bundle"
  },
  "install": {
    "bundled": true,
    "default": false,
    "sync": "account",
    "installedBefore": "2026-10-11"
  },
  "lifecycle": {
    "migrations": []
  },
  "dataLifecycle": {
    "scope": "none",
    "localData": false
  }
}
