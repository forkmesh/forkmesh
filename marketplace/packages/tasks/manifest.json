{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "tasks",
  "name": "Tasks",
  "creator": { "id": "did:forkmesh:forkmesh", "handle": "forkmesh", "displayName": "ForkMesh", "verified": true },
  "type": "extension.native",
  "category": "Productivity",
  "version": "1.1.0",
  "summary": "Plan, assign, hand off, and review organization work across people, agents, the desktop, and the office board.",
  "screenshots": [{ "path": "preview/market.svg", "alt": "Tasks board showing routed organization work, assignees, agent handoff, and QA state" }],
  "license": { "model": "free-open-source", "spdx": "MIT", "creatorRetainsOwnership": true, "terms": "Included under the ForkMesh repository licence." },
  "price": { "amount": 0, "currency": "USD" },
  "entrypoints": {
    "desktop": "builtin:tasks",
    "worker": "builtin:tasks",
    "dashboard-view": "content/web/view.html",
    "dashboard-script": "content/web/page.js",
    "settings": "builtin:package"
  },
  "contributions": [{
    "socket": "dashboard.page",
    "entrypoint": "dashboard-view",
    "config": {
      "route": "/dashboard/tasks",
      "title": "Tasks",
      "description": "The organization-private task catalog shared by ForkMesh clients and agents.",
      "script": "dashboard-script",
      "navigation": { "label": "Tasks", "icon": "list-checks", "order": 10 }
    }
  }],
  "permissions": [
    { "id": "organization.tasks.read", "label": "Read tasks for organizations you belong to", "risk": "sensitive" },
    { "id": "organization.tasks.write", "label": "Create, route, assign, complete, and review organization tasks", "risk": "sensitive" },
    { "id": "agent.tasks.delegate", "label": "Hand explicitly selected work to an organization agent", "risk": "high" }
  ],
  "dependencies": [],
  "trust": { "sourceAvailable": true, "reproducibleBuild": false, "signature": "verified-bundle" },
  "install": { "bundled": true, "default": false, "sync": "account", "installedBefore": "2026-10-11" },
  "lifecycle": { "migrations": [] },
  "dataLifecycle": { "scope": "none" }
}
