{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "diagnostics",
  "name": "Diagnostics",
  "creator": {"id": "did:forkmesh:forkmesh", "handle": "forkmesh", "displayName": "ForkMesh", "verified": true},
  "type": "extension.native",
  "category": "Operate",
  "version": "1.0.0",
  "summary": "Live performance metrics for this phone, including responsiveness, memory, network and relay health.",
  "screenshots": [{"path": "preview/market.svg", "alt": "The ForkMesh Diagnostics plugin card"}],
  "license": {"model": "free-open-source", "spdx": "MIT", "creatorRetainsOwnership": true, "terms": "Included under the ForkMesh repository licence."},
  "price": {"amount": 0, "currency": "USD"},
  "entrypoints": {"ios": "builtin:diagnostics", "settings": "builtin:package"},
  "permissions": [{"id": "diagnostics.metrics.read", "label": "Read this phone's performance metrics", "risk": "sensitive"}],
  "dependencies": [],
  "trust": {"sourceAvailable": true, "reproducibleBuild": false, "signature": "verified-bundle"},
  "install": {"bundled": true, "default": false, "sync": "account", "installedBefore": "2026-10-11", "places": ["mobile"]},
  "lifecycle": {"migrations": []},
  "dataLifecycle": {"scope": "none", "localData": true}
}
