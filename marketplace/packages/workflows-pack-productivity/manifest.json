{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "workflows-pack-productivity",
  "name": "Workflows: Productivity",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Workflow add-ons",
  "version": "1.0.0",
  "summary": "Adds 13 productivity integrations to Workflows: Notion, Airtable, Google Sheets, Google Calendar and more.",
  "screenshots": [
    {
      "path": "preview/market.svg",
      "alt": "Workflows: Productivity"
    }
  ],
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": {
    "amount": 0,
    "currency": "USD"
  },
  "entrypoints": {
    "pack": "content/pack.json",
    "settings": "builtin:package"
  },
  "contributions": [
    {
      "socket": "workflows.integrations",
      "entrypoint": "pack",
      "config": {
        "category": "Productivity",
        "integrations": [
          "notion",
          "airtable",
          "googleSheets",
          "googleCalendar",
          "googleDrive",
          "gmail",
          "microsoft365",
          "todoist",
          "trello",
          "asana",
          "clickup",
          "monday",
          "baserow"
        ]
      }
    }
  ],
  "permissions": [
    {
      "id": "network.workflows.outbound",
      "label": "Let workflow steps call productivity services you connect",
      "risk": "high"
    }
  ],
  "dependencies": [
    {
      "id": "workflows",
      "version": "^1.0.0"
    }
  ],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": true,
    "signature": "verified-bundle"
  },
  "install": {
    "bundled": true,
    "default": true,
    "sync": "account"
  },
  "lifecycle": {
    "migrations": []
  },
  "dataLifecycle": {
    "scope": "none",
    "localData": false
  }
}
