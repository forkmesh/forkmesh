{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "people",
  "name": "People",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Community",
  "version": "1.0.0",
  "summary": "People: everyone around a campfire, the most active closest to the flames. Pick someone to see their profile, follow them or send a message. On the desktop, iPhone, Android and the web.",
  "screenshots": [
    {
      "path": "preview/market.svg",
      "alt": "The People campfire: avatars on five rings around a fire"
    }
  ],
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": {
    "amount": 0,
    "currency": "USD"
  },
  "entrypoints": {
    "desktop": "builtin:people",
    "ios": "builtin:people",
    "android": "builtin:people",
    "dashboard-view": "content/web/view.html",
    "dashboard-script": "content/web/page.js",
    "settings": "builtin:package"
  },
  "contributions": [
    {
      "socket": "dashboard.page",
      "entrypoint": "dashboard-view",
      "config": {
        "route": "/dashboard/people",
        "title": "People",
        "description": "Everyone around the fire, ringed by how active they are. Open a profile to follow someone or send a message.",
        "script": "dashboard-script",
        "navigation": {
          "label": "People",
          "icon": "users",
          "order": 47
        }
      }
    }
  ],
  "permissions": [
    {
      "id": "accounts.directory.read",
      "label": "Read the public member directory: names, avatars and how recently each member was active",
      "risk": "low"
    },
    {
      "id": "accounts.follow",
      "label": "Follow and unfollow people as you, when you press Follow",
      "risk": "low"
    },
    {
      "id": "chat.direct.open",
      "label": "Open a private conversation with the person you pick",
      "risk": "low"
    }
  ],
  "dependencies": [],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": false,
    "signature": "verified-bundle"
  },
  "install": {
    "bundled": true,
    "default": false,
    "sync": "account"
  },
  "lifecycle": {
    "migrations": []
  },
  "dataLifecycle": {
    "scope": "none",
    "localData": false
  }
}
