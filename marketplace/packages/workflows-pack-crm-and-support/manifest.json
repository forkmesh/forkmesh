{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "workflows-pack-crm-and-support",
  "name": "Workflows: CRM and support",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Workflow add-ons",
  "version": "1.0.0",
  "summary": "Adds 9 crm and support integrations to Workflows: HubSpot, Salesforce, Pipedrive, Zoho CRM and more.",
  "screenshots": [
    {
      "path": "preview/market.svg",
      "alt": "Workflows: CRM and support"
    }
  ],
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": {
    "amount": 0,
    "currency": "USD"
  },
  "entrypoints": {
    "pack": "content/pack.json",
    "settings": "builtin:package"
  },
  "contributions": [
    {
      "socket": "workflows.integrations",
      "entrypoint": "pack",
      "config": {
        "category": "CRM and support",
        "integrations": [
          "hubspot",
          "salesforce",
          "pipedrive",
          "zohoCrm",
          "freshdesk",
          "zendesk",
          "intercom",
          "helpscout",
          "attio"
        ]
      }
    }
  ],
  "permissions": [
    {
      "id": "network.workflows.outbound",
      "label": "Let workflow steps call crm and support services you connect",
      "risk": "high"
    }
  ],
  "dependencies": [
    {
      "id": "workflows",
      "version": "^1.0.0"
    }
  ],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": true,
    "signature": "verified-bundle"
  },
  "install": {
    "bundled": true,
    "default": true,
    "sync": "account"
  },
  "lifecycle": {
    "migrations": []
  },
  "dataLifecycle": {
    "scope": "none",
    "localData": false
  }
}
