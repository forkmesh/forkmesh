{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "coves",
  "name": "Coves",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Personal",
  "version": "1.0.0",
  "summary": "Coves: end-to-end encrypted shared folders with the people you choose.",
  "screenshots": [
    {
      "path": "preview/market.svg",
      "alt": "The Coves plugin card"
    }
  ],
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": {
    "amount": 0,
    "currency": "USD"
  },
  "entrypoints": {
    "ios": "builtin:coves",
    "android": "builtin:coves",
    "settings": "builtin:package"
  },
  "permissions": [
    {
      "id": "coves.files",
      "label": "Read and write the encrypted files in your coves",
      "risk": "sensitive"
    }
  ],
  "dependencies": [],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": false,
    "signature": "verified-bundle"
  },
  "install": {
    "bundled": true,
    "default": false,
    "sync": "account",
    "installedBefore": "2026-10-11"
  },
  "lifecycle": {
    "migrations": []
  },
  "dataLifecycle": {
    "scope": "none",
    "localData": false
  }
}
