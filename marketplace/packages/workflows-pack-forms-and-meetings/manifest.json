{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "workflows-pack-forms-and-meetings",
  "name": "Workflows: Forms and meetings",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Workflow add-ons",
  "version": "1.0.0",
  "summary": "Adds 4 forms and meetings integrations to Workflows: Calendly, Typeform, Jotform, Zoom.",
  "screenshots": [
    {
      "path": "preview/market.svg",
      "alt": "Workflows: Forms and meetings"
    }
  ],
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": {
    "amount": 0,
    "currency": "USD"
  },
  "entrypoints": {
    "pack": "content/pack.json",
    "settings": "builtin:package"
  },
  "contributions": [
    {
      "socket": "workflows.integrations",
      "entrypoint": "pack",
      "config": {
        "category": "Forms and meetings",
        "integrations": [
          "calendly",
          "typeform",
          "jotform",
          "zoom"
        ]
      }
    }
  ],
  "permissions": [
    {
      "id": "network.workflows.outbound",
      "label": "Let workflow steps call forms and meetings services you connect",
      "risk": "high"
    }
  ],
  "dependencies": [
    {
      "id": "workflows",
      "version": "^1.0.0"
    }
  ],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": true,
    "signature": "verified-bundle"
  },
  "install": {
    "bundled": true,
    "default": true,
    "sync": "account"
  },
  "lifecycle": {
    "migrations": []
  },
  "dataLifecycle": {
    "scope": "none",
    "localData": false
  }
}
