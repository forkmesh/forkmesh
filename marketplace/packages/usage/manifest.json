{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "usage",
  "name": "Usage",
  "creator": { "id": "did:forkmesh:forkmesh", "handle": "forkmesh", "displayName": "ForkMesh", "verified": true },
  "type": "extension.native",
  "category": "Insights",
  "version": "1.0.0",
  "summary": "One current view of every Claude Code and Codex account's usage windows across your connected desktops.",
  "screenshots": [{ "path": "preview/market.svg", "alt": "Usage windows for connected AI model accounts" }],
  "license": { "model": "free-open-source", "spdx": "MIT", "creatorRetainsOwnership": true, "terms": "Included under the ForkMesh repository licence." },
  "price": { "amount": 0, "currency": "USD" },
  "entrypoints": { "desktop": "builtin:usage", "dashboard-view": "content/web/view.html", "dashboard-script": "content/web/page.js", "settings": "builtin:package" },
  "contributions": [{ "socket": "dashboard.page", "entrypoint": "dashboard-view", "config": { "route": "/dashboard/usage", "title": "Model usage", "description": "The current Claude Code and Codex usage windows reported by your connected desktops.", "script": "dashboard-script", "navigation": { "label": "Usage", "icon": "gauge", "order": 45 } } }],
  "permissions": [{ "id": "desktop.models.usage.read", "label": "Read current Claude Code and Codex usage from desktops signed in to your account", "risk": "sensitive" }],
  "dependencies": [{ "id": "agents", "version": "1.0.0" }],
  "trust": { "sourceAvailable": true, "reproducibleBuild": false, "signature": "verified-bundle" },
  "install": { "bundled": true, "default": false, "sync": "account", "places": ["mobile", "desktop", "web"] },
  "lifecycle": { "migrations": [] },
  "dataLifecycle": { "scope": "none", "localData": false }
}
