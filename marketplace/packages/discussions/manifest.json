{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "discussions",
  "name": "Discussions",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Repositories",
  "version": "1.0.0",
  "summary": "The Discussions tab of every repository: threads, answers and polls.",
  "screenshots": [
    {
      "path": "preview/market.svg",
      "alt": "The Discussions plugin card"
    }
  ],
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": {
    "amount": 0,
    "currency": "USD"
  },
  "entrypoints": {
    "desktop": "builtin:discussions",
    "ios": "builtin:discussions",
    "android": "builtin:discussions",
    "web": "builtin:discussions",
    "settings": "builtin:package"
  },
  "permissions": [
    {
      "id": "repository.discussions",
      "label": "Read and write discussions on repositories you can access",
      "risk": "low"
    }
  ],
  "dependencies": [],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": false,
    "signature": "verified-bundle"
  },
  "install": {
    "bundled": true,
    "default": false,
    "sync": "account",
    "installedBefore": "2026-10-11"
  },
  "lifecycle": {
    "migrations": []
  },
  "dataLifecycle": {
    "scope": "none",
    "localData": false
  }
}
