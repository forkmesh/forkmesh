{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "code",
  "name": "Code",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Repositories",
  "version": "1.0.0",
  "summary": "The Code view: browse the current repository's files, README and folders from the Code tab and the Home grid.",
  "screenshots": [
    {
      "path": "preview/market.svg",
      "alt": "The Code plugin card"
    }
  ],
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": {
    "amount": 0,
    "currency": "USD"
  },
  "entrypoints": {
    "desktop": "builtin:code",
    "ios": "builtin:code",
    "android": "builtin:code",
    "settings": "builtin:package"
  },
  "permissions": [
    {
      "id": "repository.read",
      "label": "Read files of the repositories you open",
      "risk": "low"
    }
  ],
  "dependencies": [],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": false,
    "signature": "verified-bundle"
  },
  "install": {
    "bundled": true,
    "default": false,
    "sync": "account",
    "installedBefore": "2026-10-11"
  },
  "lifecycle": {
    "migrations": []
  },
  "dataLifecycle": {
    "scope": "none",
    "localData": false
  }
}
