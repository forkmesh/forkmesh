{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "instance-feed",
  "name": "Feed",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Community",
  "version": "1.0.0",
  "summary": "A Mastodon-style timeline of short posts from the people on this ForkMesh instance, with replies, favourites, boosts, content warnings and profiles.",
  "screenshots": [
    {
      "path": "preview/market.svg",
      "alt": "Feed with a compose box and a timeline of posts from people on the instance"
    }
  ],
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": { "amount": 0, "currency": "USD" },
  "entrypoints": {
    "desktop": "builtin:instance-feed",
    "worker": "content/worker/instance_feed.py",
    "dashboard-view": "content/web/view.html",
    "dashboard-script": "content/web/page.js",
    "settings": "builtin:package"
  },
  "contributions": [
    {
      "socket": "dashboard.page",
      "entrypoint": "dashboard-view",
      "config": {
        "route": "/dashboard/instance-feed",
        "title": "Feed",
        "description": "Short posts from the people on this instance, newest first, with replies, favourites and boosts.",
        "script": "dashboard-script",
        "navigation": { "label": "Feed", "icon": "messages-square", "order": 47 }
      }
    }
  ],
  "permissions": [
    {
      "id": "instance.feed.read",
      "label": "Read posts, replies, favourites and boosts that people on this instance shared to the feed",
      "risk": "low"
    },
    {
      "id": "instance.feed.write",
      "label": "Publish, reply to, favourite, boost and delete your own posts, visible to everyone on this instance who uses the feed",
      "risk": "sensitive"
    },
    {
      "id": "notifications.plugin.send",
      "label": "Notify people when you reply to, mention, favourite or boost their posts",
      "risk": "low"
    }
  ],
  "dependencies": [],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": true,
    "signature": "verified-bundle"
  },
  "install": { "bundled": true, "default": false, "sync": "account", "places": ["mobile", "desktop", "web"] },
  "lifecycle": { "migrations": [] },
  "dataLifecycle": { "scope": "account", "localData": false },
  "worker": { "module": "instance_feed", "api": "/api/instance-feed", "outboundOrigins": [] }
}
