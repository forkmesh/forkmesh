{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "size-map",
  "name": "Size Map",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Repositories",
  "version": "1.0.0",
  "summary": "The repository Size map tab: a sunburst of what takes disk space in the repository folder, any folder you pick or a whole drive, with ignored files hidden or shown.",
  "screenshots": [
    {
      "path": "preview/market.webp",
      "alt": "The Size Map plugin card: a sunburst of folder sizes"
    }
  ],
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": {
    "amount": 0,
    "currency": "USD"
  },
  "entrypoints": {
    "desktop": "builtin:size-map",
    "settings": "builtin:package"
  },
  "permissions": [
    {
      "id": "storage.folders.read",
      "label": "Measure the size of the repository folder, or a folder or drive you pick",
      "risk": "low"
    }
  ],
  "dependencies": [],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": false,
    "signature": "verified-bundle"
  },
  "install": {
    "bundled": true,
    "default": false,
    "installedBefore": "2026-10-17"
  },
  "lifecycle": {
    "migrations": []
  },
  "dataLifecycle": {
    "scope": "none",
    "localData": false
  }
}
