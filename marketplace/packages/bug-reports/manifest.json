{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "bug-reports",
  "name": "Report a bug",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Support",
  "version": "1.2.0",
  "summary": "Report a bug privately to ForkMesh administrators, follow what happened to your reports, and, for administrators, triage reported bugs.",
  "screenshots": [
    {
      "path": "preview/market.svg",
      "alt": "The Report a bug plugin card"
    }
  ],
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": {
    "amount": 0,
    "currency": "USD"
  },
  "entrypoints": {
    "desktop": "builtin:bug-reports",
    "ios": "builtin:bug-reports",
    "android": "builtin:bug-reports",
    "web": "builtin:bug-reports",
    "dashboard-view": "content/web/view.html",
    "dashboard-script": "content/web/page.js",
    "settings": "builtin:package"
  },
  "contributions": [
    {
      "socket": "dashboard.page",
      "entrypoint": "dashboard-view",
      "config": {
        "route": "/dashboard/bugs",
        "title": "Bugs",
        "description": "Report a bug privately, follow your reports, and triage reported bugs if you are an administrator.",
        "script": "dashboard-script",
        "navigation": {
          "label": "Bugs",
          "icon": "bug",
          "order": 47
        }
      }
    }
  ],
  "permissions": [
    {
      "id": "support.report",
      "label": "Send your private report and selected files to ForkMesh administrators",
      "risk": "sensitive"
    }
  ],
  "dependencies": [],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": false,
    "signature": "verified-bundle"
  },
  "install": {
    "bundled": true,
    "default": false,
    "sync": "account",
    "installedBefore": "2026-10-11"
  },
  "lifecycle": {
    "migrations": []
  },
  "dataLifecycle": {
    "scope": "none",
    "localData": false
  }
}
