{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "tour",
  "name": "Tour",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Extensions",
  "version": "1.1.0",
  "summary": "The first-run welcome and a guided tour of every ForkMesh workspace, replayable from Tour in the rail. Remove it once you know your way around.",
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": {
    "amount": 0,
    "currency": "USD"
  },
  "entrypoints": {
    "desktop": "builtin:tour",
    "settings": "builtin:package"
  },
  "dataLifecycle": {
    "scope": "none",
    "localData": false
  },
  "permissions": [
    {
      "id": "chrome.rail.button",
      "label": "Add a Tour button to the desktop rail",
      "risk": "low"
    },
    {
      "id": "ui.overlay",
      "label": "Show the welcome card and spotlight the controls the tour describes",
      "risk": "low"
    }
  ],
  "screenshots": [
    {
      "path": "preview/market.png",
      "alt": "The ForkMesh tour spotlighting a rail button with a step card describing it"
    }
  ],
  "dependencies": [],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": false,
    "signature": "verified-bundle"
  },
  "install": {
    "bundled": true,
    "default": false,
    "sync": "account",
    "installedBefore": "2026-10-11"
  },
  "lifecycle": {
    "migrations": []
  }
}
