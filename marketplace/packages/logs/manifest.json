{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "logs",
  "name": "Logs",
  "creator": {"id": "did:forkmesh:forkmesh", "handle": "forkmesh", "displayName": "ForkMesh", "verified": true},
  "type": "extension.native",
  "category": "Operate",
  "version": "1.0.0",
  "summary": "A compact live log console for this phone, connected desktops and saved hosts. Choose the log streams you need.",
  "screenshots": [{"path": "preview/market.svg", "alt": "The ForkMesh Logs plugin card"}],
  "license": {"model": "free-open-source", "spdx": "MIT", "creatorRetainsOwnership": true, "terms": "Included under the ForkMesh repository licence."},
  "price": {"amount": 0, "currency": "USD"},
  "entrypoints": {"desktop": "builtin:logs", "ios": "builtin:logs", "android": "builtin:logs", "settings": "builtin:package"},
  "settings": [{"key": "enabled", "type": "boolean", "label": "Collect logs", "default": true}],
  "permissions": [{"id": "diagnostics.logs.read", "label": "Read local, desktop and saved-host diagnostic logs", "risk": "sensitive"}],
  "dependencies": [],
  "trust": {"sourceAvailable": true, "reproducibleBuild": false, "signature": "verified-bundle"},
  "install": {"bundled": true, "default": false, "sync": "account", "installedBefore": "2026-10-11"},
  "lifecycle": {"migrations": []},
  "dataLifecycle": {"scope": "none", "localData": true}
}
