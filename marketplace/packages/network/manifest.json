{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "network",
  "name": "Network & nodes",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Operate",
  "version": "1.0.0",
  "summary": "Network & nodes: the ForkMesh nodes you know, relays, peers and sync state.",
  "screenshots": [
    {
      "path": "preview/market.svg",
      "alt": "The Network & nodes plugin card"
    }
  ],
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": {
    "amount": 0,
    "currency": "USD"
  },
  "entrypoints": {
    "desktop": "builtin:network",
    "ios": "builtin:network",
    "android": "builtin:network",
    "web": "builtin:network",
    "settings": "builtin:package"
  },
  "permissions": [
    {
      "id": "network.nodes",
      "label": "Read the nodes, relays and peers your node talks to",
      "risk": "low"
    }
  ],
  "dependencies": [],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": false,
    "signature": "verified-bundle"
  },
  "install": {
    "bundled": true,
    "default": false,
    "sync": "account",
    "installedBefore": "2026-10-11"
  },
  "lifecycle": {
    "migrations": []
  },
  "dataLifecycle": {
    "scope": "none",
    "localData": false
  }
}
