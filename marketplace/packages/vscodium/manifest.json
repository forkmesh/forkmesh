{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "vscodium",
  "name": "VSCodium",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Developer Tools",
  "version": "1.0.0",
  "summary": "Adds a Codium button to the branch diff header that opens the branch's local checkout in VSCodium installed on this computer.",
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": {
    "amount": 0,
    "currency": "USD"
  },
  "entrypoints": {
    "desktop": "content/desktop/VSCodiumDesktopExtension.cpp",
    "settings": "builtin:package"
  },
  "permissions": [
    {
      "id": "desktop.branch.action",
      "label": "Add a Codium button to the branch diff header",
      "risk": "low"
    },
    {
      "id": "process.vscodium.start",
      "label": "Start VSCodium on the reviewed branch's checkout when you click the button",
      "risk": "sensitive"
    }
  ],
  "screenshots": [
    {
      "path": "preview/market.png",
      "alt": "Branch diff header with the Codium button beside the branch actions"
    }
  ],
  "dependencies": [],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": false,
    "signature": "verified-bundle"
  },
  "install": {
    "bundled": true,
    "default": false
  },
  "lifecycle": {
    "migrations": []
  }
}
