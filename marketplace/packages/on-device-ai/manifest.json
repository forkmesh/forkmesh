{
  "$schema": "../../manifest.schema.json",
  "schemaVersion": 1,
  "id": "on-device-ai",
  "name": "On-device AI",
  "creator": {
    "id": "did:forkmesh:forkmesh",
    "handle": "forkmesh",
    "displayName": "ForkMesh",
    "verified": true
  },
  "type": "extension.native",
  "category": "Personal",
  "version": "1.0.0",
  "summary": "On-device AI: download a small model to the phone and chat with it offline; nothing leaves the device.",
  "screenshots": [
    {
      "path": "preview/market.svg",
      "alt": "The On-device AI plugin card"
    }
  ],
  "license": {
    "model": "free-open-source",
    "spdx": "MIT",
    "creatorRetainsOwnership": true,
    "terms": "Included under the ForkMesh repository licence."
  },
  "price": {
    "amount": 0,
    "currency": "USD"
  },
  "entrypoints": {
    "ios": "builtin:on-device-ai",
    "android": "builtin:on-device-ai",
    "settings": "builtin:package"
  },
  "permissions": [
    {
      "id": "device.model.download",
      "label": "Download an AI model to this device and run it locally",
      "risk": "low"
    }
  ],
  "dependencies": [],
  "trust": {
    "sourceAvailable": true,
    "reproducibleBuild": false,
    "signature": "verified-bundle"
  },
  "install": {
    "bundled": true,
    "default": false,
    "sync": "account",
    "installedBefore": "2026-10-11"
  },
  "lifecycle": {
    "migrations": []
  },
  "dataLifecycle": {
    "scope": "none",
    "localData": false
  }
}
