{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forkmesh.com/schemas/fmpkg-manifest-v1.json",
  "title": "ForkMesh Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "creator",
    "type",
    "version",
    "summary",
    "license",
    "price",
    "entrypoints",
    "permissions",
    "screenshots",
    "lifecycle"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "maxLength": 96
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "handle", "displayName", "verified"],
      "properties": {
        "id": { "type": "string", "pattern": "^did:forkmesh:" },
        "handle": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "verified": { "type": "boolean" }
      }
    },
    "type": {
      "enum": [
        "extension.native",
        "extension.vscode",
        "virtual.world",
        "virtual.avatar",
        "virtual.object",
        "virtual.clothing",
        "virtual.animation",
        "virtual.audio",
        "agent",
        "service.agent",
        "service.development",
        "service.design",
        "service.hosting",
        "service.compute",
        "theme"
      ]
    },
    "category": { "type": "string", "minLength": 1, "maxLength": 40 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "spdx", "creatorRetainsOwnership"],
      "properties": {
        "model": {
          "enum": [
            "free-open-source",
            "one-time",
            "commercial",
            "subscription",
            "pay-what-you-want",
            "limited-edition",
            "free-with-paid-source",
            "revenue-share"
          ]
        },
        "spdx": { "type": "string", "minLength": 1, "maxLength": 64 },
        "creatorRetainsOwnership": { "const": true },
        "terms": { "type": "string", "maxLength": 200 }
      }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "entrypoints": {
      "type": "object",
      "minProperties": 1,
      "required": ["settings"],
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "contributions": {
      "description": "Host-neutral plugin sockets. Hosts activate the socket names they understand and ignore the rest; entrypoint names resolve through the package-owned entrypoints map.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["socket", "entrypoint"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$",
            "maxLength": 64
          },
          "socket": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
            "maxLength": 96
          },
          "entrypoint": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$",
            "maxLength": 64
          },
          "config": {
            "type": "object"
          }
        }
      }
    },
    "settings": {
      "description": "Declarative package settings every host renders: boolean toggles and choice pickers.",
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "type", "label", "default"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,39}$" },
          "type": { "enum": ["boolean", "choice"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "default": { "type": ["boolean", "string"] },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "label"],
              "properties": {
                "value": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,40}$" },
                "label": { "type": "string", "minLength": 1, "maxLength": 60 }
              }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "risk"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.]*$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "risk": { "enum": ["low", "sensitive", "high"] }
        }
      }
    },
    "screenshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "alt"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^preview/",
            "maxLength": 240
          },
          "alt": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "revenueSharePercent": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceAvailable": { "type": "boolean" },
        "reproducibleBuild": { "type": "boolean" },
        "signature": { "enum": ["required", "verified-bundle", "unverified"] }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundled": { "type": "boolean" },
        "default": { "type": "boolean" },
        "sync": {
          "description": "account: the install state and declared settings live on the user's ForkMesh account and follow every device; dependencies install with the package and dependents are removed with it.",
          "enum": ["account"]
        },
        "installedBefore": {
          "description": "A YYYY-MM-DD date. Projects and accounts created before it start with the package installed; newer ones start with install.default, which must be false. Lets a feature turn off by default for new projects without disappearing from existing ones.",
          "type": "string",
          "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "places": {
          "description": "The apps the package can show up in: mobile (iPhone and Android), desktop, web. Left out means all three. The user picks which of these an install shows in.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["mobile", "desktop", "web"] }
        }
      }
    },
    "lifecycle": {
      "description": "Package-owned install migrations. Every up migration has a mandatory down migration, applied in reverse order on uninstall.",
      "type": "object",
      "additionalProperties": false,
      "required": ["migrations"],
      "properties": {
        "migrations": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "up", "down"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9]{4}_[a-z][a-z0-9_-]*$",
                "maxLength": 96
              },
              "database": {
                "description": "Host-managed database capability requested by this migration.",
                "enum": ["device", "organization"]
              },
              "up": {
                "type": "string",
                "pattern": "^migrations/",
                "maxLength": 240
              },
              "down": {
                "type": "string",
                "pattern": "^migrations/",
                "maxLength": 240
              }
            }
          }
        }
      }
    },
    "service": {
      "description": "Optional background service run by forkmesh-core as a separate, sandboxed process (docs/desktop/service-plugins.md).",
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "exec", "methods"],
      "properties": {
        "api": { "const": 1 },
        "exec": { "type": "string", "pattern": "^content/[A-Za-z0-9._/-]+$", "maxLength": 200 },
        "interpreter": { "enum": ["python3", "sh", "bash", "node"] },
        "start": { "enum": ["lazy", "boot"] },
        "methods": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]{0,63}$" } },
        "events": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]{0,63}$" } },
        "remoteMethods": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]{0,63}$" } },
        "remoteEvents": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]{0,63}$" } },
        "idleExitSeconds": { "type": "integer", "minimum": 10, "maximum": 86400 },
        "memoryMB": { "type": "integer", "minimum": 64, "maximum": 4096 }
      }
    },
    "worker": {
      "description": "Optional Worker module and API route contributed by this package.",
      "type": "object",
      "additionalProperties": false,
      "required": ["module"],
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "api": {
          "type": "string",
          "pattern": "^/api/[a-z][a-z0-9-]{0,63}$"
        },
        "outboundOrigins": {
          "description": "Exact HTTPS origins the package Worker may call through the generic host adapter.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?(?::[1-9][0-9]{0,4})?$",
            "maxLength": 300
          }
        }
      }
    },
    "dataLifecycle": {
      "description": "Server-side data owned by a package Worker module. organization: organizations install the package and the host exports and purges their data during uninstall. account: each account installs the package for itself through the package API, owns its data privately, and the host purges it when the account is deleted.",
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": { "enum": ["none", "organization", "account"] },
        "localData": {
          "type": "boolean",
          "description": "The package keeps the user's own records in its package data on the desktop. Removing the package wipes that data, so the desktop offers to export it before removal and to import a saved copy when the package is installed again."
        }
      }
    }
  }
}
