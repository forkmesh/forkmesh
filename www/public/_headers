  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=1800

/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=1800

/blog/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=1800

/blog/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=1800

/dashboard.js
  Cache-Control: public, max-age=31536000, immutable

# Per-page chunks of dashboard.js (app/src/dashboard_bundle.py LAZY_CHUNKS),
# always referenced with a content-hash ?v=.
/dashboard-page-*
  Cache-Control: public, max-age=31536000, immutable

/dashboard-chat.js
  Cache-Control: public, max-age=31536000, immutable

# This module is imported by both the content-hashed dashboard bundle and the
# standalone chat module. Revalidate it on every page load so a vocabulary or
# normalization update cannot remain pinned behind an older module-cache entry.
/chat-moderation.js
  Cache-Control: no-store, max-age=0, must-revalidate

# Generated after the deploy stage from the exact compact Python payload and
# World assets validated for that upload. Operators must never retain an older
# deployment's budget readings after a refresh.
/worker-footprint.json
  Cache-Control: no-store, max-age=0, must-revalidate
  Content-Type: application/json; charset=utf-8

# Same shape: the account event channel is imported by /chat.js AND by
# /world/world.js. Everything under /world/* is no-store so a refresh can never
# reuse an older module graph, and this module is part of that graph despite
# living outside the tree (the world Worker only routes /world/*, so it resolves
# on the relay). It has to revalidate with the rest of them.
/account-events.js
  Cache-Control: no-store, max-age=0, must-revalidate

/assets/logo-mark.webp
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Unversioned files on the dashboard's first paint (docs/PERF_REPO_PAGE.md):
# tailwind.css is render-blocking and analytics.js runs before dashboard.js,
# so a revalidation round trip for either delayed every warm page load. A
# cached copy is used at once and refreshed in the background.
/dashboard/tailwind.css
  Cache-Control: public, max-age=0, stale-while-revalidate=86400

/analytics.js
  Cache-Control: public, max-age=0, stale-while-revalidate=86400

/safe-input.js
  Cache-Control: public, max-age=0, stale-while-revalidate=86400

/assets/logo-96.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/logo.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/sol-48.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Third-party libraries served from this origin under a versioned file name
# (no extra DNS/TLS handshake to a CDN before dashboard.js may run).
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# The password-reset request form renders the Cloudflare Turnstile widget
# (app/src/turnstile.py), so only these documents may load its script and
# frame. /signup is Worker-rendered and gets the same policy from
# _apply_browser_security_headers in app/src/entry.py.
/forgot-password
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://challenges.cloudflare.com 'unsafe-inline' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; media-src 'self' blob: https:; frame-src 'self' https://challenges.cloudflare.com https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests

/forgot-password.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://challenges.cloudflare.com 'unsafe-inline' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; media-src 'self' blob: https:; frame-src 'self' https://challenges.cloudflare.com https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests

# Chat is rendered inside sandboxed, same-origin World frames. Keep every
# other page non-frameable, while replacing the global DENY policy only on the
# chat document (/chat and /chat.html). Cloudflare applies unsets before
# sets for this matching rule, so the restrictive global CSP is not retained
# as a second policy.
/chat
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; media-src 'self' blob: https: mediastream:; frame-src 'self' https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  ! Permissions-Policy
  Permissions-Policy: camera=(self), geolocation=(), payment=(), usb=(), serial=(), browsing-topics=(), microphone=(self), clipboard-write=(self)

/chat.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; media-src 'self' blob: https: mediastream:; frame-src 'self' https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  ! Permissions-Policy
  Permissions-Policy: camera=(self), geolocation=(), payment=(), usb=(), serial=(), browsing-topics=(), microphone=(self), clipboard-write=(self)

# Repository issue and pull-request details are reused verbatim by the World
# sidebar. Keep each exception limited to its four-segment detail route and
# same-origin parents; repository indexes and every other site page retain the
# global DENY policy.
/:owner/:repo/issues/:number
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; media-src 'self' blob: https:; frame-src 'self' https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN

/:owner/:repo/pull/:number
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; media-src 'self' blob: https:; frame-src 'self' https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
