{
  "schemaVersion": 1,
  "definitionOfDone": "www/docs/engineering/definition-of-done.md",
  "requiredPullRequestEvidence": [
    {
      "id": "threat-review",
      "heading": "Threat review"
    },
    {
      "id": "abuse-privacy-review",
      "heading": "Abuse and privacy review"
    },
    {
      "id": "benchmark-evidence",
      "heading": "Benchmark and budget evidence"
    },
    {
      "id": "regression-evidence",
      "heading": "Regression-test evidence"
    },
    {
      "id": "operational-evidence",
      "heading": "Operational evidence"
    }
  ],
  "performanceBudgets": [
    {
      "id": "worker-catalog-3000",
      "metric": "wall-seconds",
      "maximum": 0.5,
      "enforcedBy": "app/tests/test_perf_budgets.py::test_catalog_get_is_linear_and_bounded_at_scale"
    },
    {
      "id": "collaboration-fold-corpus-25",
      "metric": "wall-seconds",
      "maximum": 3.0,
      "enforcedBy": "app/tests/test_collaboration_protocol.py::test_fold_hot_path_budget_after_signature_cache_is_warm"
    },
    {
      "id": "repository-migration-setup-p50",
      "metric": "milliseconds",
      "maximum": 180000,
      "enforcedBy": "app/tests/test_repository_migration.py::test_setup_p50_and_p95_are_reported_separately_from_transfer"
    },
    {
      "id": "daily-startup",
      "metric": "milliseconds",
      "maximum": 2500,
      "enforcedBy": "app/browser_tests/tests/daily-interface.spec.js::daily interface startup and repository browse stay within budget"
    },
    {
      "id": "daily-repository-browse",
      "metric": "milliseconds",
      "maximum": 1000,
      "enforcedBy": "app/browser_tests/tests/daily-interface.spec.js::daily interface startup and repository browse stay within budget"
    },
    {
      "id": "daily-search",
      "metric": "milliseconds",
      "maximum": 100,
      "enforcedBy": "app/browser_tests/tests/daily-interface.spec.js::daily interface startup and repository browse stay within budget"
    },
    {
      "id": "daily-diff-render",
      "metric": "milliseconds",
      "maximum": 500,
      "enforcedBy": "app/browser_tests/tests/dashboard-pull-files-deep-link.spec.js::daily interface diff rendering is addressable, readable, and within budget"
    },
    {
      "id": "daily-navigation",
      "metric": "milliseconds",
      "maximum": 250,
      "enforcedBy": "app/browser_tests/tests/dashboard-pull-files-deep-link.spec.js::daily interface diff rendering is addressable, readable, and within budget"
    },
    {
      "id": "daily-feedback",
      "metric": "milliseconds",
      "maximum": 100,
      "enforcedBy": "app/browser_tests/tests/daily-interface.spec.js::daily interface command palette is keyboard complete and restores focus"
    }
  ],
  "gates": [
    {
      "id": "python-syntax",
      "category": "regression",
      "command": [
        "{python}",
        "-m",
        "compileall",
        "-q",
        "app/src",
        "tools"
      ]
    },
    {
      "id": "security-privacy-contracts",
      "category": "security",
      "command": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "app/tests/test_non_custodial_surfaces.py",
        "app/tests/test_public_security_claims.py",
        "app/tests/test_private_repository_control_access.py",
        "app/tests/test_sensitive_mutation_audit.py",
        "app/tests/test_secret_gate.py"
      ]
    },
    {
      "id": "performance-budgets",
