{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forkmesh.com/schemas/mirror-endpoint-v1.json",
  "title": "ForkMesh signed direct-HTTPS mirror endpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "generatedAt",
    "node",
    "endpoint",
    "dns",
    "storage",
    "signature"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "type": {"const": "forkmesh.mirror-endpoint"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "publicKey"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "publicKey": {
          "type": "string",
          "description": "32-byte Ed25519 public key, base64url without padding",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "healthUrl",
        "manifestUrl",
        "repositoryUrlTemplate",
        "transport",
        "mainProxyMode"
      ],
      "properties": {
        "origin": {"type": "string", "pattern": "^https://[^/]+$"},
        "healthUrl": {"type": "string", "pattern": "^https://[^/]+/health$"},
        "manifestUrl": {
          "type": "string",
          "pattern": "^https://[^/]+/forkmesh-mirror\\.json$"
        },
        "repositoryUrlTemplate": {
          "type": "string",
          "pattern": "^https://[^/]+/\\{owner\\}/\\{repository\\}$"
        },
        "transport": {"const": "direct-https"},
        "mainProxyMode": {"const": "masked"}
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordName", "proxied", "workerRoute"],
      "properties": {
        "recordName": {"type": "string"},
        "proxied": {"const": true},
        "workerRoute": {"type": "string", "pattern": "/\\*$"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryBytesInD1",
        "repositoryByteOwner",
        "d1Purpose"
      ],
      "properties": {
        "repositoryBytesInD1": {"const": false},
        "repositoryByteOwner": {"const": "independent-mirror-host"},
        "d1Purpose": {
          "type": "array",
          "items": {
            "enum": [
              "service-discovery",
              "health-metadata",
              "routing-metadata",
              "signed-manifests"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "encoding",
        "canonicalization",
        "payloadSha256",
        "value"
      ],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "encoding": {"const": "base64url-no-padding"},
        "canonicalization": {"const": "forkmesh-json-sort-v1"},
        "payloadSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "value": {
          "type": "string",
          "description": "64-byte Ed25519 signature, base64url without padding",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
