+SERVICE_NAME_RE = re.compile(r"[a-z][A-Za-z0-9_]{0,63}")
+SERVICE_INTERPRETERS = {"python3", "sh", "bash", "node"}
+SERVICE_FIELDS = {
+    "api", "exec", "interpreter", "start", "methods", "events",
+    "remoteMethods", "remoteEvents", "idleExitSeconds", "memoryMB",
