{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forkmesh.com/schemas/mirror-actions-summary-v1.json",
  "title": "ForkMesh mirror Actions public summary",
  "description": "Short-lived, secret-free run metadata written atomically by the node owner. Runtime policy additionally requires a positive lease no longer than 15 minutes and a UTF-8 logTail no larger than 16 KiB. Version 1 is the original document. Version 2 adds per-run workflowPath, pullNumber and steps plus the top-level repositories catalog and controls outcomes (see operations/mirror-actions-control.md); neither version carries workflow content, commands, variables, or local paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "node",
    "updatedAt",
    "expiresAt",
    "runs"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "type": {
      "const": "forkmesh.mirror-actions-summary"
    },
    "node": {
      "type": "string",
      "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "updatedAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "runs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "repositories": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "controls": {
      "description": "Newest first. A request id may repeat when a replayed envelope is rejected after the original was applied.",
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/control"
      }
    }
  },
  "oneOf": [
    {
      "title": "Version 1",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "repositories": false,
        "controls": false,
        "runs": {
          "items": {
            "properties": {
              "workflowPath": false,
              "pullNumber": false,
              "steps": false
            }
          }
        }
      }
    },
    {
      "title": "Version 2",
      "required": [
        "repositories",
        "controls"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "runs": {
          "items": {
            "required": [
              "id",
              "owner",
              "repository",
              "workflow",
              "commit",
              "ref",
              "status",
              "createdAt",
              "startedAt",
              "finishedAt",
              "logTail",
              "workflowPath",
              "pullNumber",
              "steps"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "timestampOrZero": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "repository",
        "workflow",
        "commit",
        "ref",
        "status",
        "createdAt",
        "startedAt",
        "finishedAt",
        "logTail"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "workflow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "ref": {
          "type": "string",
          "pattern": "^refs/(?:heads|tags)/(?!/)(?!.*(?:\\.\\.|//))[A-Za-z0-9._/-]{1,160}(?<!/)$"
        },
        "status": {
          "enum": [
            "awaiting-approval",
            "queued",
            "running",
            "success",
            "failed",
            "rejected",
            "cancelled",
            "skipped"
          ]
        },
        "createdAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "startedAt": {
          "$ref": "#/$defs/timestampOrZero"
        },
        "finishedAt": {
          "$ref": "#/$defs/timestampOrZero"
        },
        "logTail": {
          "description": "Tail of ActionStore's already-redacted UTF-8 log. Runtime enforces a 16 KiB encoded-byte limit.",
          "type": "string",
          "maxLength": 16384
        },
        "workflowPath": {
          "description": "Version 2 only. Empty when the run has no workflow file.",
          "type": "string",
          "pattern": "^(?:|\\.forkmesh/[A-Za-z0-9._-]{1,96}\\.ya?ml)$"
        },
        "pullNumber": {
          "description": "Version 2 only. 0 when the run is not a pull-request run.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "steps": {
          "description": "Version 2 only.",
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[^\\u0000\\r\\n]*$"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "success",
            "failed",
            "skipped",
            "cancelled"
          ]
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "repository",
        "actionsEnabled",
        "workflows"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "actionsEnabled": {
          "type": "boolean"
        },
        "workflows": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/workflow"
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "name",
        "events",
        "manual",
        "enabled",
        "runsOn",
        "valid"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.forkmesh/[A-Za-z0-9._-]{1,96}\\.ya?ml$"
        },
        "name": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[^\\u0000\\r\\n]*$"
        },
        "events": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[^\\u0000\\r\\n]*$"
          }
        },
        "manual": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "runsOn": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\u0000\\r\\n]*$"
          }
        },
        "valid": {
          "type": "boolean"
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "repository",
        "requestId",
        "action",
        "status",
        "reason",
        "runId",
        "finishedAt"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,64}$"
        },
        "action": {
          "enum": [
            "dispatch",
            "rerun",
            "cancel",
            "approve",
            "reject",
            "set-workflow-enabled",
            "set-repository-enabled"
          ]
        },
        "status": {
          "enum": [
            "applied",
            "rejected"
          ]
        },
        "reason": {
          "enum": [
            "",
            "actions_disabled",
            "invalid_request",
            "not_awaiting_approval",
            "not_cancellable",
            "not_manual",
            "operator_disabled",
            "ref_not_found",
            "repository_not_found",
            "run_not_found",
            "workflow_disabled",
            "workflow_invalid",
            "workflow_not_found",
            "wrong_node"
          ]
        },
        "runId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finishedAt": {
          "$ref": "#/$defs/timestampOrZero"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "applied"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
