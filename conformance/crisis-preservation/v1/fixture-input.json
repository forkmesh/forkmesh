  "plans": [
    {
      "id": "planned-shutdown-everything-fits",
      "note": "A month of owner access holds every category.",
      "request": {"scenario": "planned_shutdown", "repository": {"sizeMb": 800, "issues": 2500, "releases": 40, "assetsMb": 1500}},
      "expectMode": "standard",
      "expectDecisions": {"refs": "included", "releases": "included", "documentation": "included", "issues": "included", "artifacts": "included", "identity_proofs": "included", "trusted_mirrors": "included"}
    },
    {
      "id": "urgent-takedown-tight-window",
      "note": "Twenty minutes: the Git history, identity, and the import fit; a second operator and artifact files do not.",
      "request": {"scenario": "urgent_takedown", "minutes": 20, "repository": {"sizeMb": 300, "issues": 4000, "releases": 20, "assetsMb": 200}},
      "expectMode": "urgent",
      "expectDecisions": {"refs": "included", "identity_proofs": "included", "trusted_mirrors": "deferred", "releases": "included", "documentation": "included", "issues": "included", "artifacts": "deferred"}
    },
    {
      "id": "urgent-takedown-history-over-budget",
      "note": "The Git history alone outruns five minutes: it is still started and flagged, and everything else is deferred.",
      "request": {"scenario": "urgent_takedown", "minutes": 5, "repository": {"sizeMb": 2000, "issues": 100, "releases": 5, "assetsMb": 0}},
      "expectMode": "urgent",
      "expectDecisions": {"refs": "included", "identity_proofs": "deferred", "trusted_mirrors": "deferred", "releases": "deferred", "documentation": "deferred", "issues": "deferred", "artifacts": "deferred"}
    },
    {
      "id": "lost-account-owner-access-lowered",
      "note": "Owner access is impossible without the account; a private source is then unreachable.",
      "request": {"scenario": "lost_account", "access": "owner", "repository": {"private": true, "sizeMb": 50, "issues": 200, "releases": 10, "assetsMb": 100}},
      "expectMode": "standard",
      "expectDecisions": {"refs": "unavailable", "identity_proofs": "included", "trusted_mirrors": "unavailable", "releases": "unavailable", "documentation": "unavailable", "issues": "unavailable", "artifacts": "unavailable"}
    },
    {
      "id": "lost-account-private-local-clone",
      "note": "A local clone still carries the history and in-repository documentation of a private source.",
      "request": {"scenario": "lost_account", "repository": {"private": true, "localClone": true, "sizeMb": 50, "issues": 200, "releases": 10, "assetsMb": 100}},
      "expectMode": "standard",
      "expectDecisions": {"refs": "included", "identity_proofs": "included", "trusted_mirrors": "included", "releases": "unavailable", "documentation": "included", "issues": "unavailable", "artifacts": "unavailable"}
    },
    {
      "id": "censorship-public-rate-limited",
      "note": "Anonymous provider rate limits push the whole import past thirty minutes; later import parts are deferred by import order.",
      "request": {"scenario": "censorship", "minutes": 30, "repository": {"sizeMb": 100, "issues": 3000, "releases": 20, "assetsMb": 100}},
      "expectMode": "urgent",
      "expectDecisions": {"refs": "included", "trusted_mirrors": "included", "identity_proofs": "included", "releases": "deferred", "documentation": "deferred", "artifacts": "included", "issues": "deferred"}
    },
    {
      "id": "provider-eol-source-gone",
      "note": "The provider is already gone and there is no local clone: only identity proofs can still be made.",
      "request": {"scenario": "provider_eol", "access": "none"},
      "expectMode": "standard",
      "expectDecisions": {"refs": "unavailable", "releases": "unavailable", "documentation": "unavailable", "issues": "unavailable", "artifacts": "unavailable", "identity_proofs": "included", "trusted_mirrors": "unavailable"}
    },
    {
      "id": "provider-eol-private-read-token",
      "note": "A read-scoped token reaches a large private source; a week holds all of it.",
      "request": {"scenario": "provider_eol", "access": "read", "repository": {"private": true, "sizeMb": 5000, "issues": 20000, "releases": 300, "assetsMb": 20000}},
      "expectMode": "standard",
      "expectDecisions": {"refs": "included", "releases": "included", "documentation": "included", "issues": "included", "artifacts": "included", "identity_proofs": "included", "trusted_mirrors": "included"}
    },
    {
      "id": "censorship-defaults-fit-urgent-window",
      "note": "Four hours is still urgent mode, but with default sizes nothing is traded off, so no acknowledgement is needed.",
      "request": {"scenario": "censorship"},
      "expectMode": "urgent",
      "expectDecisions": {"refs": "included", "trusted_mirrors": "included", "identity_proofs": "included", "releases": "included", "documentation": "included", "artifacts": "included", "issues": "included"}
    }
  ],
