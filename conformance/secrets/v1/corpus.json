 "boundaries": [
  "publication",
  "review-diff",
  "pre-commit",
  "git-objects"
 ],
 "bounds": {
  "maxFalseNegativeRate": 0.15,
  "maxFalsePositiveRate": 0.1
 },
 "policy": {
  "schemaVersion": 1,
  "mode": "block",
  "allowlist": [
   {
    "paths": [
     "*/tests/fixtures/fake/*"
