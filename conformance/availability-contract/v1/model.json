  "policy": {
    "minVerificationIntervalMs": 60000,
    "maxSlots": 10000,
    "maxFailureTolerance": 2,
    "minContractedOperators": 2,
    "money": "integer micro-USD; credits are fee * creditBps // 10000",
    "attainment": "met slots * 10000 // counted slots, rounded down",
    "privacy": "Operator accounts are never echoed; copies that share an operator share an opaque operator number for the whole bundle. Endpoints, mirror URLs, drill archive paths, and node keys are never echoed."
  },
  "terms": [
    {"id": "copies", "meaning": "Verified copies that must hold the counted state in every slot."},
    {"id": "operators", "meaning": "Distinct operators that must hold the same verified state in every slot; at least the availability-proof quorum target."},
    {"id": "regions", "meaning": "Distinct declared regions among verified copies in every slot."},
    {"id": "uptimeBps", "meaning": "Share of counted slots that must meet every check."},
    {"id": "verificationIntervalMs", "meaning": "Slot length; a slot with no observation is unverified."},
    {"id": "transports", "meaning": "Transports that must each have at least one verified copy: router, directHttps, smartHttp."},
    {"id": "refCoverage", "meaning": "At least the contracted operator count of verified copies carry every branch."},
    {"id": "artifactCoverage", "meaning": "At least the contracted operator count of verified copies carry every release artifact."},
    {"id": "recoveryTimeObjectiveMs", "meaning": "Longest allowed incident and the slowest allowed restore drill."},
    {"id": "drillIntervalMs", "meaning": "Oldest allowed restore drill at period end."},
    {"id": "incidentResponseMs", "meaning": "Longest allowed time from an incident's start to its acknowledgement."},
    {"id": "failureTolerance", "meaning": "How many operators, and separately how many regions, may fail at once while the quorum holds."},
    {"id": "maxExcludedBps", "meaning": "Share of slots that honored exclusions may remove."}
  ],
  "transports": ["router", "directHttps", "smartHttp"],
  "capacityClasses": ["community", "contracted"],
  "exclusionKinds": ["scheduled-maintenance", "customer-requested", "legal-hold"],
  "exclusionReasons": ["unknown_kind", "announced_late", "over_budget"],
  "checks": [
    "unverified", "quorum_below_contract", "copies_below_contract",
