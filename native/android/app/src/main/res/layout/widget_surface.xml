<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/widget_new_agent"
            android:textColor="#FFB4C6FF"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/widget_row_0"
        style="@style/WidgetRow">

        <TextView
            android:id="@+id/widget_row_0_title"
            style="@style/WidgetRowTitle" />

        <TextView
            android:id="@+id/widget_row_0_detail"
            style="@style/WidgetRowDetail" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_1"
        style="@style/WidgetRow">

        <TextView
            android:id="@+id/widget_row_1_title"
            style="@style/WidgetRowTitle" />

        <TextView
            android:id="@+id/widget_row_1_detail"
            style="@style/WidgetRowDetail" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_2"
        style="@style/WidgetRow">

        <TextView
            android:id="@+id/widget_row_2_title"
            style="@style/WidgetRowTitle" />

        <TextView
            android:id="@+id/widget_row_2_detail"
            style="@style/WidgetRowDetail" />
    </LinearLayout>
</LinearLayout>
