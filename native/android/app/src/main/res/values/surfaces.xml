<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="widget_new_agent">New agent</string>
    <string name="widget_agents_label">ForkMesh agents</string>
    <string name="widget_agents_description">Runs that need you, are running or are queued.</string>
    <string name="widget_inbox_label">ForkMesh inbox</string>
    <string name="widget_inbox_description">Your newest unread pings.</string>
    <string name="tile_new_agent">New agent</string>

    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="WidgetRowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="WidgetRowDetail">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#99FFFFFF</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
