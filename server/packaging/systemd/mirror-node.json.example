{
  "schemaVersion": 1,
  "listen": "127.0.0.1:8791",
  "gatewayProbe": "127.0.0.1:8790",
  "gatewayConfig": "/var/lib/forkmesh/.local/share/ForkMesh/ForkMesh/mirror-gateway/config.json",
