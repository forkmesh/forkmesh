    <!-- VS Code codicons (CC BY 4.0, see icons/LICENSE-codicons.txt), used where
         octicons has no equivalent glyph. tintedOcticonPixmap falls back to this
         prefix, so themedOcticon("worktree") and themedOcticon("checklist")
         resolve here. -->
    <qresource prefix="/icons/codicons">
        <file alias="checklist.svg">icons/codicons/checklist.svg</file>
