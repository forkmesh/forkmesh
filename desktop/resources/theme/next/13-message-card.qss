QMessageBox[nextMessageCard="true"] {
    background-color: @surface; border: 1px solid @borderStrong; border-radius: 12px;
}
QMessageBox[nextMessageCard="true"] QLabel { background: transparent; }
QMessageBox[nextMessageCard="true"] QLabel#qt_msgbox_label {
    color: @fg; font-size: 14px; font-weight: 400;
}
QMessageBox[nextMessageHeading="true"] QLabel#qt_msgbox_label {
    font-size: 15px; font-weight: 600;
}
QMessageBox[nextMessageCard="true"] QLabel#qt_msgbox_informativelabel {
    color: @fgMuted; font-size: 13px;
}
QMessageBox[nextMessageCard="true"] QCheckBox { color: @fgSecondary; font-size: 13px; }
QMessageBox[nextMessageCard="true"] QTextEdit {
    background-color: @bgSubtle; border: 1px solid @border; border-radius: 8px;
    color: @fgSecondary; font-size: 12px;
}
QMessageBox[nextMessageCard="true"] QDialogButtonBox { margin-top: 12px; min-width: 340px; }
QMessageBox[nextMessageCard="true"] QPushButton {
    min-height: 30px; min-width: 64px; padding: 0px 14px; border-radius: 8px;
}
QMessageBox[nextMessageCard="true"] QPushButton:default {
    background-color: @accent; border: 1px solid @accent; color: @onAccent; font-weight: 600;
}
QMessageBox[nextMessageCard="true"] QPushButton:default:hover {
    background-color: @accentHover; border-color: @accentHover;
}
QMessageBox[nextMessageCard="true"] QPushButton:default:pressed {
    background-color: @accentPressed; border-color: @accentPressed;
}
#messageCardScrim { background-color: rgba(0, 0, 0, 0.45); }
