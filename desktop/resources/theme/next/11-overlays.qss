#commandPaletteScrim { background-color: rgba(0, 0, 0, 0.55); }

#commandPaletteCard {
    background-color: @surface; border: 1px solid @borderStrong; border-radius: 14px;
}
#commandPaletteCard QLabel { background: transparent; }

QLineEdit#commandPaletteInput {
    background: transparent; color: @fg;
    border: none; border-bottom: 1px solid @border; border-radius: 0px;
    padding: 14px 16px; font-size: 15px;
    selection-background-color: @accent; selection-color: @onAccent;
}
QLineEdit#commandPaletteInput:hover, QLineEdit#commandPaletteInput:focus {
    background: transparent; border: none; border-bottom: 1px solid @border;
}

QListWidget#commandPaletteList {
    background: transparent; border: none; outline: none; padding: 0px;
}
QListWidget#commandPaletteList::item {
    background: transparent; color: @fgSecondary;
    border: none; border-radius: 8px; padding: 8px 10px;
}
QListWidget#commandPaletteList::item:hover { background-color: @surfaceRaised; color: @fg; }
QListWidget#commandPaletteList::item:selected { background-color: @surfaceActive; color: @fg; }
QListWidget#commandPaletteList::item:disabled {
    background: transparent; color: @fgSubtle;
    font-size: 11px; font-weight: 600; padding: 10px 10px 2px 10px;
}

#commandPaletteFooter {
    background-color: @bgSubtle; border: none; border-top: 1px solid @border;
    border-bottom-left-radius: 13px; border-bottom-right-radius: 13px;
}
#commandPaletteFooter QLabel { background: transparent; color: @fgMuted; font-size: 12px; }
#commandPaletteFooter QLabel#keyHint {
    color: @fgSecondary; background-color: @surfaceRaised;
    border: 1px solid @borderStrong; border-radius: 4px;
    padding: 0px 5px; font-size: 11px; font-weight: 500;
}
