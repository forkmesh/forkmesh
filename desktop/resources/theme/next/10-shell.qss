#appWindowFrame { background-color: @border; }
#windowChromeBar { background-color: @bgSubtle; border: none; }
#serverRail, #navRail { background-color: @bgSubtle; border: none; }
#appNavigationRail, #appNavigationRailContent {
    background-color: @bgSubtle; border: none;
}
#shellContentCard {
    background-color: @bg; border: 1px solid @border; border-radius: 14px;
}
#sideRail, #sideRailColumn, #sideRailScroll, #sideRailContent, #sideRailBrowserPanel,
#sideRailTerminalPanel {
    background-color: @bgSubtle; border: none;
}
#sideRailBrowserHandle:hover, #sideRailTerminalHandle:hover { background-color: @border; }
QLabel#sideRailBrowserTitle {
    color: @fgSubtle; font-size: 11px; font-weight: 500; letter-spacing: 1px; background: transparent;
}
QFrame#sideRailSeparator { color: @border; background-color: @border; border: none; max-height: 1px; }
QPushButton[sideRailTool="true"], QToolButton#sideRailItem {
    background: transparent; border: 1px solid transparent; border-radius: 10px; padding: 0;
}
QPushButton[sideRailTool="true"]:hover, QToolButton#sideRailItem:hover { background-color: @surfaceRaised; }
QPushButton[sideRailTool="true"]:checked { background-color: @accentSubtle; border-color: @accent; }
QPushButton#sideRailAddButton {
    background: transparent; border: 1px dashed @borderStrong; border-radius: 10px; padding: 0;
}
QPushButton#sideRailAddButton:hover { background-color: @surfaceRaised; border-color: @accent; }
#terminalsPage { background-color: @bg; }
QLabel#terminalsTitle { color: @fg; font-size: 15px; font-weight: 600; }
QLabel#terminalsAgentStatus, QLabel#terminalsEmpty { color: @fgMuted; }
QPushButton#terminalsShareButton:checked { color: @accentFg; border-color: @accent; }
#debugBar { background-color: @bgSubtle; border-top: 1px solid @border; }
#footerLogPanel { background-color: @bg; border: 1px solid @border; border-radius: 8px; }

QPushButton#topNavButton { font-weight: 500; }
QPushButton#topNavButton:hover { background-color: @surfaceRaised; color: @fg; }
QPushButton#topNavButton:checked {
    background-color: @surfaceActive; color: @fg; border-color: transparent;
}
QPushButton#windowChromeButton:hover {
    background-color: @surfaceRaised; color: @fg; border-color: transparent;
}

#repoTabBar { border-bottom: 1px solid @border; }
QPushButton#repoTab { font-weight: 500; }
QPushButton#repoTab:checked {
    color: @fg; border-bottom: 2px solid @accentFg; border-radius: 0; background: transparent;
}

#globalSearch {
    background-color: @surface; border: 1px solid @border; border-radius: 8px;
    padding: 4px 8px; color: @fg;
}
#globalSearch:focus { border-color: @accent; }
#globalSearchPopup {
    background-color: @surface; border: 1px solid @borderStrong;
    border-radius: 10px; padding: 4px; outline: none;
    selection-background-color: @surfaceActive; selection-color: @fg;
}
#globalSearchPopup::item:selected { background-color: @surfaceActive; color: @fg; }

#sidebar QListWidget::item:selected {
    background-color: @surfaceActive; color: @fg;
    border-radius: 6px; padding: 5px 8px; margin: 1px 0;
}
#sidebar QTreeWidget::item:selected {
    background-color: @surfaceActive; color: @fg;
    border-radius: 6px; padding: 5px 8px; margin: 1px 0;
}
#sidebar QListWidget::item:hover, #sidebar QTreeWidget::item:hover {
    background-color: @surfaceRaised; border-radius: 6px; padding: 5px 8px; margin: 1px 0;
}

#fileTabs QTabBar::tab:selected, #repoSettingsTabs QTabBar::tab:selected {
    background: @surface; color: @fg; border-color: @border; border-bottom-color: @surface;
}
#networkTabs QTabBar::tab {
    background-color: transparent; color: @fgMuted; border: 1px solid transparent;
    border-radius: 6px; font-weight: 500;
}
#networkTabs QTabBar::tab:hover { background-color: @surfaceRaised; color: @fg; }
#networkTabs QTabBar::tab:selected {
    background-color: @surfaceActive; border-color: transparent; color: @fg;
}

#onboardingBrand { color: @fgMuted; font-weight: 600; letter-spacing: 1px; }
#onboardingKicker { color: @fgMuted; font-weight: 600; letter-spacing: 0px; }
#onboardingTitle { color: @fg; font-size: 24px; font-weight: 600; }
#onboardingCard { background-color: @surface; border: 1px solid @borderStrong; border-radius: 16px; }
#onboardingFeatureBadge { background-color: @surfaceActive; color: @fg; }
QProgressBar#onboardingProgress::chunk { background-color: @accent; border-radius: 2px; }

QPushButton#agentsMagicButton {
    background: @accent; border: 1px solid @accent; border-radius: 8px;
    color: @onAccent; font-weight: 600;
}
QPushButton#agentsMagicButton:hover { background: @accentHover; border-color: @accentHover; }
QPushButton#agentsMagicButton:checked { background: @accentPressed; border-color: @accentPressed; }
QPushButton#quickAddGenieButton {
    background: @surfaceRaised; border: 1px solid @borderStrong; color: @fgSecondary;
    border-radius: 6px; font-weight: 500;
}
QPushButton#quickAddGenieButton:hover {
    background: @surfaceActive; border-color: @borderStrong; color: @fg;
}
QPushButton#teammateBriefingGenerate, QPushButton#teammateBriefingRunAgain {
    color: @onAccent; background-color: @accent; border: 1px solid @accent;
    border-radius: 8px; font-weight: 600;
}
QPushButton#teammateBriefingGenerate:hover, QPushButton#teammateBriefingRunAgain:hover {
    background-color: @accentHover; border-color: @accentHover;
}

#welcomeScrim { background-color: rgba(0, 0, 0, 0.62); }
#welcomeCard {
    background-color: @surface; border: 1px solid @borderStrong; border-radius: 16px;
}
#welcomeCard QLabel { background: transparent; }
#welcomeBrand { color: @fgMuted; font-size: 11px; font-weight: 600; letter-spacing: 2px; }
#welcomeTitle { color: @fg; font-size: 24px; font-weight: 600; }
#welcomeLede { color: @fgMuted; font-size: 14px; }
#welcomeFootnote {
    background-color: @bgSubtle; border: 1px solid @border; border-radius: 8px;
}
#welcomeFootnote QLabel { color: @fgMuted; font-size: 12px; }
QPushButton#welcomeLink {
    background: transparent; border: none; color: @accentFg;
    font-weight: 500; padding: 2px 0; text-align: left;
}
QPushButton#welcomeLink:hover { color: @accentHover; }

#railToggleButton { background: transparent; border: 1px solid transparent; border-radius: 6px; padding: 0; }
#railToggleButton:hover { background-color: @surfaceRaised; }
#railGroupHeading {
    color: @fgSubtle; font-size: 11px; font-weight: 500; background: transparent;
    padding: 8px 10px 2px 10px;
}

#sidebarHeader, #sidebarFooter { background-color: @bgSubtle; }
#sidebarFooter { border-top: 1px solid @border; }
QPushButton#sidebarWorkspace, QPushButton#sidebarAccount {
    background: transparent; border: none; border-radius: 8px; padding: 0px; text-align: left;
}
QPushButton#sidebarWorkspace:hover, QPushButton#sidebarAccount:hover,
QPushButton#sidebarWorkspace:pressed, QPushButton#sidebarAccount:pressed {
    background-color: @surfaceRaised;
}
#sidebarHeader QLabel, #sidebarFooter QLabel { background: transparent; border: none; }
QLabel#sidebarTitle { color: @fg; font-size: 13px; font-weight: 600; }
#sidebarFooter QLabel#sidebarTitle { font-weight: 500; }
QLabel#sidebarSubtitle { color: @fgMuted; font-size: 11px; }
QPushButton#sidebarNewSession {
    background-color: @surface; border: 1px solid @border; border-radius: 8px;
    padding: 0px; text-align: left;
}
QPushButton#sidebarNewSession:hover { background-color: @surfaceRaised; }
QLabel#sidebarNewSessionText { color: @fg; font-size: 13px; font-weight: 500; }
QLabel#sidebarKbd, QLabel#topSearchKbd {
    color: @fgMuted; font-size: 10px; font-weight: 500; background-color: @surface;
    border: 1px solid @border; border-radius: 4px; min-width: 12px; padding: 0px 3px;
    min-height: 18px; max-height: 18px;
}
#globalSearch { font-size: 13px; }

QMenu#workspaceMenu { border-radius: 12px; padding: 4px; }
QMenu#workspaceMenu::separator { height: 1px; background: @border; margin: 4px 0px; }
QLabel#workspaceMenuHeading {
    color: @fgSubtle; font-size: 11px; font-weight: 500; letter-spacing: 1px;
    padding: 6px 8px 4px 8px; background: transparent;
}
QPushButton#workspaceMenuRow {
    background: transparent; border: none; border-radius: 6px; padding: 0px; text-align: left;
}
QPushButton#workspaceMenuRow:hover, QPushButton#workspaceMenuRow:focus {
    background-color: @surfaceActive;
}
QPushButton#workspaceMenuRow QLabel { background: transparent; border: none; }
QLabel#workspaceMenuRowTitle { color: @fg; font-size: 13px; }
QLabel#workspaceMenuRowHint { color: @fgMuted; font-size: 12px; }

QLabel#topPageTitle {
    color: @fgMuted; font-size: 13px; font-weight: 500; background: transparent;
    padding-left: 4px;
}
QPushButton[topIconButton="true"] {
    background: transparent; border: none; border-radius: 6px; padding: 0px;
}
QPushButton[topIconButton="true"]:hover { background-color: @surfaceRaised; }
QPushButton[topStatusButton="true"] {
    background: transparent; border: none; border-radius: 6px; color: @fgMuted;
    font-size: 12px; padding: 0px 8px; text-align: left;
}
QPushButton[topStatusButton="true"]:hover { background-color: @surfaceRaised; color: @fg; }
#topRightCluster { background: transparent; }
QPushButton[trafficLight="close"], QPushButton[trafficLight="minimize"],
QPushButton[trafficLight="zoom"] {
    border-radius: 6px; padding: 0px; min-width: 12px; max-width: 12px;
    min-height: 12px; max-height: 12px;
}
QPushButton[trafficLight="close"] { background-color: #ff5f57; border: 1px solid #e0443e; }
QPushButton[trafficLight="minimize"] { background-color: #febc2e; border: 1px solid #dea123; }
QPushButton[trafficLight="zoom"] { background-color: #28c840; border: 1px solid #1aab29; }

QFrame#pingsPopover {
    background-color: @surface; border: 1px solid @borderStrong; border-radius: 12px;
}
#pingsPopoverHead { background: transparent; border-bottom: 1px solid @border; }
QLabel#pingsPopoverTitle { color: @fg; font-size: 14px; font-weight: 600; background: transparent; }
QPushButton#pingsPopoverLink {
    background: transparent; border: none; color: @fgMuted; font-size: 12px; padding: 0px;
}
QPushButton#pingsPopoverLink:hover { color: @fg; }
#pingsPopoverList, #pingsPopoverFoot { background: transparent; }
#pingsPopoverFoot { border-top: 1px solid @border; }
QPushButton#pingsPopoverRow {
    background: transparent; border: none; border-radius: 8px; text-align: left; padding: 0px;
}
QPushButton#pingsPopoverRow:hover { background-color: @surfaceRaised; }
QLabel#pingsPopoverRowTitle { color: @fg; font-size: 14px; background: transparent; }
QLabel#pingsPopoverRowMeta { color: @fgMuted; font-size: 12px; background: transparent; }
QLabel#pingsPopoverEmpty { color: @fgSubtle; font-size: 13px; background: transparent; }
QPushButton#pingsPopoverAll {
    background: transparent; border: none; border-radius: 8px; color: @fgMuted; font-size: 13px;
}
QPushButton#pingsPopoverAll:hover { background-color: @surfaceRaised; color: @fg; }
