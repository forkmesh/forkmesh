#homeSection { background: transparent; }
#homeSection QLabel#pageTitle[homeRole="greeting"] {
    font-size: 30px; font-weight: 600; color: @fg;
}
#homeSection QLabel#mutedLabel[homeRole="headline"] { font-size: 15px; color: @fgMuted; }

#homeComposer {
    background-color: @surface; border: 1px solid @borderStrong; border-radius: 16px;
}
#homeComposer[focused="true"] { border-color: @fgSubtle; }
#homeComposerInput {
    background: transparent; border: none; color: @fg; font-size: 15px;
    selection-background-color: @selection; selection-color: @fg;
}
#homeComposer QLabel { background: transparent; border: none; padding: 0px; }
#homeComposer QPushButton[homeRole="chip"] {
    background: transparent; border: none; border-radius: 8px; padding: 0px;
}
#homeComposer QPushButton[homeRole="chip"]:hover,
#homeComposer QPushButton[homeRole="chip"]:focus { background-color: @surfaceRaised; }
#homeComposer QLabel#homeChipText { color: @fgSecondary; font-size: 14px; background: transparent; }
#homeComposer QPushButton#homeComposerModel QLabel#homeChipText { color: @fg; }
#homeComposer QLabel#homeChipDetail { color: @fgSubtle; font-size: 14px; background: transparent; }
#homeComposer QPushButton#homeComposerSend {
    background-color: @surfaceActive; border: none; border-radius: 16px; padding: 0px;
}
#homeComposer QPushButton#homeComposerSend:enabled { background-color: @fg; }
#homeComposer QPushButton#homeComposerSend:enabled:hover { background-color: @fgSecondary; }

QPushButton[homeRole="suggestion"] {
    background: transparent; border: 1px solid @borderStrong; border-radius: 15px;
    color: @fgMuted; font-size: 13px; padding: 0px 14px; min-height: 30px;
}
QPushButton[homeRole="suggestion"]:hover { background-color: @surfaceRaised; color: @fg; }

#homeSection QLabel[homeRole="sectionHeading"] {
    color: @fgSubtle; font-size: 12px; font-weight: 500; letter-spacing: 1px;
}
#homeSection QPushButton[homeRole="sectionLink"] {
    background: transparent; border: none; color: @fgMuted; font-size: 13px;
    padding: 0px; min-height: 20px;
}
#homeSection QPushButton[homeRole="sectionLink"]:hover { color: @fg; }

#homeNeedsYou {
    background-color: @surface; border: 1px solid @border; border-radius: 12px;
}
#homeNeedsYou QPushButton[homeRole="ping"] {
    background: transparent; border: none; border-radius: 0px;
    border-bottom: 1px solid @border; text-align: left; padding: 0px;
}
#homeNeedsYou QPushButton[homeRole="ping"][last="true"] { border-bottom: none; }
#homeNeedsYou QPushButton[homeRole="ping"]:hover { background-color: @surfaceRaised; }
#homeNeedsYou QLabel[homeRole="pingTitle"] { color: @fg; font-size: 14px; background: transparent; }
#homeNeedsYou QLabel[homeRole="pingMeta"] { color: @fgSubtle; font-size: 12px; background: transparent; }
#homeNeedsYou QLabel[homeRole="empty"] { color: @fgSubtle; font-size: 13px; padding: 18px; }

QMenu#homePickerMenu {
    background-color: @surface; border: 1px solid @borderStrong; border-radius: 12px;
    padding: 6px;
}
QMenu#homePickerMenu QWidget#homePickerBody { background: transparent; }
QMenu#homePickerMenu QLineEdit#homePickerSearch {
    background: transparent; border: none; border-radius: 0px;
    min-height: 38px; padding: 0px 6px; font-size: 14px; color: @fg;
}
QMenu#homePickerMenu QListWidget#homePickerList {
    background: transparent; border: none; border-top: 1px solid @border;
    outline: none; padding-top: 4px;
}
QMenu#homePickerMenu QListWidget#homePickerList[first="true"] { border-top: none; }
QMenu#homePickerMenu QFrame#homePickerRule { background-color: @border; border: none; }
QMenu#homePickerMenu QPushButton#homePickerFooter {
    background: transparent; border: none; border-radius: 8px; color: @fgSecondary;
    font-size: 14px; text-align: left; padding: 0px 10px; min-height: 36px;
}
QMenu#homePickerMenu QPushButton#homePickerFooter:hover { background-color: @surfaceRaised; color: @fg; }
QMenu#homePickerMenu QLabel[homeRole="pickerHeading"] {
    color: @fgSubtle; font-size: 11px; font-weight: 500; letter-spacing: 1px;
    padding: 6px 10px 2px 10px; background: transparent;
}
