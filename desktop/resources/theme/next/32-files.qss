#filesSection > QLabel#mutedLabel {
    color: @fgMuted; font-size: 13px; background: transparent;
}
#filesSection > QCheckBox {
    color: @fgMuted; font-size: 13px; padding: 0px; spacing: 6px;
}
#filesSection > QCheckBox:hover { color: @fg; }

#filesSection QPushButton#ghostButton {
    background-color: transparent; border: 1px solid transparent; border-radius: 6px;
    color: @fgMuted; font-size: 13px; font-weight: 500;
    padding: 4px 8px; min-height: 18px;
}
#filesSection QPushButton#ghostButton:hover {
    background-color: @surfaceRaised; color: @fg;
}
#filesSection QPushButton#ghostButton:pressed { background-color: @surfaceActive; }
#filesSection QPushButton#ghostButton:checked {
    background-color: @surfaceActive; color: @fg;
}
#filesSection QPushButton#ghostButton:disabled {
    background-color: transparent; color: @fgSubtle;
}
#filesSection > QPushButton#primaryButton {
    border-radius: 6px; font-size: 13px; padding: 4px 12px; min-height: 18px;
}
#filesSection > QPushButton#primaryButton[filesQuiet="true"] {
    background-color: @surfaceRaised; border: 1px solid @borderStrong;
    color: @fg; font-weight: 500;
}
#filesSection > QPushButton#primaryButton[filesQuiet="true"]:hover {
    background-color: @surfaceActive; border-color: @borderStrong;
}
#filesSection > QPushButton#primaryButton[filesQuiet="true"]:pressed {
    background-color: @surface; border-color: @borderStrong;
}
#filesSection > QPushButton#primaryButton[filesQuiet="true"]:disabled {
    background-color: @surfaceRaised; border-color: @border; color: @fgSubtle;
}
#filesSection > QFrame[filesRule="true"] { background-color: @border; border: none; }

QLineEdit#filesPathBar, QLineEdit#filesCommitMessage {
    background-color: @surface; border: 1px solid @border; border-radius: 8px;
    color: @fg; font-size: 13px; padding: 4px 10px; min-height: 18px;
}
QLineEdit#filesPathBar {
    color: @fgSecondary; font-size: 12px;
    font-family: "Geist Mono", "SF Mono", "Menlo", "Consolas", "DejaVu Sans Mono",
        "Liberation Mono", "Noto Sans Mono", monospace;
}
QLineEdit#filesPathBar:hover, QLineEdit#filesCommitMessage:hover {
    border-color: @borderStrong;
}
QLineEdit#filesPathBar:focus, QLineEdit#filesCommitMessage:focus {
    border-color: @accent; color: @fg;
}
QLineEdit#filesCommitMessage:disabled {
    background-color: @surfaceRaised; border-color: @border; color: @fgSubtle;
}

#filesEditorSplitter::handle:vertical { background: transparent; }
#filesExplorerSplitter::handle:horizontal {
    width: 9px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 transparent, stop:0.44 transparent, stop:0.45 @border,
        stop:0.55 @border, stop:0.56 transparent, stop:1 transparent);
}
#filesExplorerSplitter::handle:horizontal:hover,
#filesExplorerSplitter::handle:horizontal:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 transparent, stop:0.33 transparent, stop:0.34 @accent,
        stop:0.66 @accent, stop:0.67 transparent, stop:1 transparent);
}
#filesEditorSplitter::handle:vertical:hover, #filesEditorSplitter::handle:vertical:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 transparent, stop:0.33 transparent, stop:0.34 @accent,
        stop:0.66 @accent, stop:0.67 transparent, stop:1 transparent);
}

#filesSymbolPanel #searchResultsTree {
    background-color: @bg; border: 1px solid @border; border-radius: 12px;
    padding: 6px; outline: none; font-size: 13px; color: @fgSecondary;
    show-decoration-selected: 0;
}
#filesSection #fileTree {
    background-color: @bg; border: none; border-radius: 0px;
    padding: 0px; outline: none; font-size: 13px; color: @fgSecondary;
    show-decoration-selected: 0;
}
#filesSection #fileTree::item, #filesSymbolPanel #searchResultsTree::item {
    padding: 0px; border: none;
}
#filesSection #fileTree::branch, #filesSection #fileTree::branch:hover,
#filesSection #fileTree::branch:selected,
#filesSymbolPanel #searchResultsTree::branch,
#filesSymbolPanel #searchResultsTree::branch:hover,
#filesSymbolPanel #searchResultsTree::branch:selected {
    background: transparent; border-image: none; image: none;
}
#filesSection #fileTree QHeaderView::section {
    background-color: @bg; color: @fgSubtle; border: none;
    border-bottom: 1px solid @border; padding: 0px 8px; min-height: 36px;
    font-size: 12px; font-weight: 400;
}

#filesEditorColumn > QLabel#mutedLabel {
    color: @fgMuted; font-size: 12px; background: transparent;
}
#filesEditorColumn > QLabel#mutedLabel[filesRole="cursor"] {
    font-family: "Geist Mono", "SF Mono", "Menlo", "Consolas", "DejaVu Sans Mono",
        "Liberation Mono", "Noto Sans Mono", monospace;
}

#filesSection #fileTabs::pane { border: none; top: 0px; padding: 6px 0px 0px 0px; }
#filesSection #fileTabs QTabBar { font-size: 13px; font-weight: 500; }
#filesSection #fileTabs QTabBar::tab {
    background: transparent; color: @fgMuted;
    border: none; border-bottom: 2px solid transparent;
    border-top-left-radius: 6px; border-top-right-radius: 6px;
    padding: 6px 8px 4px 8px; margin: 0px 2px 0px 0px;
}
#filesSection #fileTabs QTabBar::tab:hover { background: @surfaceRaised; color: @fg; }
#filesSection #fileTabs QTabBar::tab:selected {
    background: @surface; color: @fg;
    border: none; border-bottom: 2px solid @accentFg;
}
#filesSection #fileTabs QTabBar::close-button {
    image: url(@closeIcon); subcontrol-position: right;
    padding: 2px; margin: 2px;
    border: none; border-radius: 4px; background: transparent;
}
#filesSection #fileTabs QTabBar::close-button:hover {
    image: url(@closeHoverIcon); background-color: @surfaceActive;
}
#filesSection #fileTabs QTabBar::tear { image: none; width: 0px; }
#filesSection #fileTabs QTabBar QToolButton {
    background-color: @bg; border: none; border-radius: 6px; margin: 4px 0px 6px 0px;
}
#filesSection #fileTabs QTabBar QToolButton:hover { background-color: @surfaceRaised; }

#filesSection #fileTabs QPlainTextEdit#codeEditor,
#filesSection #fileTabs QPlainTextEdit#filesPreview {
    background-color: @bg; color: @fg;
    border: 1px solid @border; border-radius: 12px; padding: 8px 4px 8px 0px;
    font-family: "Geist Mono", "SF Mono", "Menlo", "Consolas", "DejaVu Sans Mono",
        "Liberation Mono", "Noto Sans Mono", monospace;
    font-size: 13px;
    selection-background-color: @selection; selection-color: @fg;
}
#filesSection #fileTabs QPlainTextEdit#filesPreview {
    padding: 12px 4px 12px 16px; color: @fgSecondary;
}
#filesSection #fileTabs QPlainTextEdit#codeEditor::corner,
#filesSection #fileTabs QPlainTextEdit#filesPreview::corner {
    background: transparent; border: none;
}
#filesSection #fileTabs #codeLineNumberArea {
    font-family: "Geist Mono", "SF Mono", "Menlo", "Consolas", "DejaVu Sans Mono",
        "Liberation Mono", "Noto Sans Mono", monospace;
    font-size: 13px;
}
#filesSection #fileTabs QTextBrowser#markdownPreview {
    background-color: @bg; color: @fg;
    border: none; border-radius: 0px; padding: 0px;
    font-size: 14px;
}

#filesFindBar QLineEdit#issueSearch {
    background-color: @surface; border: 1px solid @border; border-radius: 8px;
    color: @fg; font-size: 13px; padding: 4px 10px;
    min-height: 18px; max-height: 18px;
}
#filesFindBar QLineEdit#issueSearch:hover { border-color: @borderStrong; }
#filesFindBar QLineEdit#issueSearch:focus { border-color: @accent; }
#filesFindBar QPushButton#ghostButton {
    background-color: transparent; border: 1px solid transparent; border-radius: 6px;
    color: @fgMuted; font-size: 12px; font-weight: 500;
    padding: 4px 8px; min-height: 18px; max-height: 18px;
}
#filesFindBar QPushButton#ghostButton:hover {
    background-color: @surfaceRaised; color: @fg;
}
#filesFindBar QPushButton#ghostButton:checked {
    background-color: @surfaceActive; color: @fg;
}
#filesFindBar QPushButton#ghostButton:disabled { color: @fgSubtle; }
#filesFindBar QLabel#hintLabel {
    color: @fgMuted; font-size: 12px; background: transparent; padding: 0px 4px;
}

#filesSymbolPanel QLabel#mutedLabel {
    color: @fgMuted; font-size: 12px; background: transparent;
}
#filesSymbolPanel QPushButton#logFilterChip {
    background-color: transparent; border: 1px solid transparent; border-radius: 6px;
    color: @fgMuted; font-size: 12px; font-weight: 500; padding: 3px 9px;
}
#filesSymbolPanel QPushButton#logFilterChip:hover {
    background-color: @surfaceRaised; color: @fg;
}
#filesSymbolPanel QPushButton#logFilterChip:checked {
    background-color: @surfaceActive; color: @fg;
}
#filesSymbolPanel QPushButton#ghostButton {
    background-color: transparent; border: 1px solid transparent; border-radius: 6px;
    padding: 4px 6px;
}
#filesSymbolPanel QPushButton#ghostButton:hover { background-color: @surfaceRaised; }

#filesSection > QFrame[filesHairline="true"],
#filesInfoPanel QFrame[filesHairline="true"] { background-color: @border; border: none; }
#filesSection > QLabel#mutedLabel[filesStatusBar="true"],
#filesSection > QLabel#filesSelectionLabel,
#filesSection > QLabel#filesStatusHint {
    color: @fgSubtle; font-size: 11px; background: transparent;
    min-height: 32px; max-height: 32px;
}

#filesPlaces {
    background-color: transparent; border: none; border-right: 1px solid @border;
}
#filesPlaces QLabel[filesPlacesHeading="true"] {
    color: @fgSubtle; font-size: 11px; font-weight: 500; letter-spacing: 0.6px;
    background: transparent; padding: 4px 8px 4px 8px;
}
#filesPlaces QPushButton[filesPlace="true"] {
    background-color: transparent; border: none; border-radius: 8px;
    color: @fgMuted; font-size: 13px; font-weight: 400; text-align: left;
    padding: 0px 8px; min-height: 32px; max-height: 32px;
}
#filesPlaces QPushButton[filesPlace="true"]:hover { background-color: @surfaceRaised; color: @fg; }
#filesPlaces QPushButton[filesPlace="true"][filesPlaceActive="true"] {
    background-color: @surfaceActive; color: @fg;
}
#filesPlaces QPushButton#filesSourcePicker {
    background-color: @surface; border: 1px solid @border; border-radius: 8px;
    color: @fg; font-size: 13px; font-weight: 500; text-align: left;
    padding: 0px 28px 0px 10px; min-height: 30px; max-height: 30px;
}
#filesPlaces QPushButton#filesSourcePicker:hover { border-color: @borderStrong; }
#filesPlaces QPushButton#filesSourcePicker:pressed,
#filesPlaces QPushButton#filesSourcePicker:open { border-color: @accent; }
#filesPlaces QPushButton#filesSourcePicker::menu-indicator {
    image: url(@chevronIcon); subcontrol-origin: padding;
    subcontrol-position: center right; right: 10px; width: 12px; height: 12px;
}
#filesPlaces QFrame#filesDiskCard {
    background-color: @surface; border: 1px solid @border; border-radius: 12px;
}
#filesDiskCard QLabel { background: transparent; }
#filesDiskCard QLabel#filesDiskName { color: @fg; font-size: 13px; }
#filesDiskCard QLabel#filesDiskCaption { color: @fgSubtle; font-size: 12px; }
#filesDiskCard QProgressBar#filesDiskBar {
    background-color: @surfaceActive; border: none; border-radius: 3px;
}
#filesDiskCard QProgressBar#filesDiskBar::chunk { background-color: @accent; border-radius: 3px; }

#filesSection > QPushButton#ghostButton[filesTool="true"] {
    background-color: transparent; border: 1px solid transparent; border-radius: 6px;
    padding: 0px; min-height: 0px; color: @fgMuted;
}
#filesSection > QPushButton#ghostButton[filesTool="true"]:hover {
    background-color: @surfaceRaised; color: @fg;
}
#filesSection > QPushButton#ghostButton[filesTool="true"]:pressed {
    background-color: @surfaceActive;
}
#filesSection > QPushButton#ghostButton[filesTool="true"]:checked {
    background-color: transparent;
}
#filesSection > QPushButton#ghostButton[filesTool="true"]:checked:hover {
    background-color: @surfaceRaised;
}
#filesSection > QPushButton#ghostButton[filesTool="true"]:disabled {
    background-color: transparent;
}

#filesCrumbs { background: transparent; }
#filesCrumbs QPushButton[filesCrumb="true"] {
    background-color: transparent; border: none; border-radius: 6px;
    color: @fgMuted; font-size: 13px; font-weight: 400;
    padding: 3px 6px; min-height: 0px;
}
#filesCrumbs QPushButton[filesCrumb="true"]:hover { background-color: @surfaceRaised; color: @fg; }
#filesCrumbs QPushButton[filesCrumb="true"][filesCrumbCurrent="true"] {
    color: @fg; font-weight: 500;
}
#filesCrumbs QLabel { background: transparent; }
#filesCrumbs QLabel[filesCrumbLabel="true"] {
    color: @fgMuted; font-size: 13px; padding: 0px 6px;
}
#filesCrumbs QLabel[filesCrumbLabel="true"][filesCrumbCurrent="true"] {
    color: @fg; font-weight: 500;
}

QLineEdit#filesFolderSearch {
    background-color: @surface; border: 1px solid @border; border-radius: 6px;
    color: @fg; font-size: 13px; padding: 0px 8px 0px 2px;
    min-height: 26px; max-height: 26px;
}
QLineEdit#filesFolderSearch:hover { border-color: @borderStrong; }
QLineEdit#filesFolderSearch:focus { border-color: @accent; }

#filesInfoPanel { background: transparent; border: none; }
#filesInfoPanel QLabel { background: transparent; }
#filesInfoPanel QLabel#filesInfoName { color: @fg; font-size: 15px; font-weight: 600; }
#filesInfoPanel QLabel#filesInfoKind { color: @fgMuted; font-size: 12px; }
#filesInfoPanel QLabel[filesInfoCaption="true"] { color: @fgMuted; font-size: 13px; }
#filesInfoPanel QLabel#filesInfoSize, #filesInfoPanel QLabel#filesInfoModified {
    color: @fg; font-size: 13px;
}
#filesInfoPanel QLabel#filesInfoWhere {
    color: @fg; font-size: 12px;
    font-family: "Geist Mono", "SF Mono", "Menlo", "Consolas", "DejaVu Sans Mono",
        "Liberation Mono", "Noto Sans Mono", monospace;
}
#filesInfoPanel QPushButton[filesInfoAction="true"] {
    background-color: transparent; border: 1px solid @borderStrong; border-radius: 8px;
    color: @fg; font-size: 13px; font-weight: 500;
    padding: 0px 10px; min-height: 30px; max-height: 30px;
}
#filesInfoPanel QPushButton[filesInfoAction="true"]:hover { background-color: @surfaceRaised; }
#filesInfoPanel QPushButton[filesInfoAction="true"]:pressed { background-color: @surfaceActive; }
#filesInfoPanel QPushButton[filesInfoAction="true"]:disabled {
    color: @fgSubtle; border-color: @border;
}
