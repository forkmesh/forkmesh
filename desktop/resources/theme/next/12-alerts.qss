#pageNoticeArea { background: transparent; }

#pageNoticeArea #inlineNotice {
    background-color: @surfaceRaised; border: 1px solid @borderStrong; border-radius: 8px;
}
#pageNoticeArea #inlineNotice QLabel { background: transparent; color: @fgSecondary; font-size: 12px; }
#pageNoticeArea #inlineNotice[tone="danger"] { background-color: @dangerSubtle; border-color: @danger; }
#pageNoticeArea #inlineNotice[tone="danger"] QLabel { color: @danger; }
#pageNoticeArea #inlineNotice[tone="accent"] { background-color: @accentSubtle; border-color: @accent; }
#pageNoticeArea #inlineNotice[tone="accent"] QLabel { color: @accentFg; }

#pageNoticeArea #inlineNotice QPushButton#ghostButton {
    background: transparent; border: 1px solid transparent; border-radius: 6px;
    color: @fgMuted; font-size: 12px; font-weight: 500; text-align: center;
    padding: 0px 4px; min-height: 22px; max-height: 22px;
}
#pageNoticeArea #inlineNotice QPushButton#ghostButton:hover {
    background-color: @surfaceActive; color: @fg;
}
#pageNoticeArea #inlineNotice QPushButton#ghostButton:pressed {
    background-color: @surfaceActive; color: @fg;
}
