QSplitter#agentWorkspaceSplit[workspaceNext="true"]::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 transparent, stop:0.428 transparent, stop:0.429 @border,
        stop:0.571 @border, stop:0.572 transparent, stop:1 transparent);
}
QWidget#agentsListPane[workspaceNext="true"] { background-color: @bgSubtle; }
QWidget#agentsListPane[workspaceNext="true"] #issueTable {
    background: transparent; border: none;
}
QWidget#workspaceSidebarHeader QLabel { background: transparent; }
#workspaceBrand { color: @fg; font-size: 16px; font-weight: 600; }
#workspaceSidebarTitle { color: @fgMuted; font-size: 12px; font-weight: 500; }
#workspaceSidebarCount { color: @fgSubtle; font-size: 12px; }
QWidget#workspaceSidebarFooter {
    background-color: @bgSubtle; border-top: 1px solid @border;
}
QPushButton#workspaceQueue {
    color: @fgSubtle; background: transparent; border: none; border-radius: 6px;
    padding: 0px 6px; font-size: 12px; text-align: left;
}
QPushButton#workspaceQueue:hover { color: @fg; background-color: @surfaceRaised; }
QPushButton[workspaceIconButton="true"] {
    background: transparent; border: none; border-radius: 8px; padding: 0px;
}
QPushButton[workspaceIconButton="true"]:hover { background-color: @surfaceRaised; }
QPushButton[workspaceIconButton="true"]:pressed,
QPushButton[workspaceIconButton="true"]:checked { background-color: @surfaceActive; }
QPushButton[workspaceIconButton="true"]:disabled { background: transparent; }

QWidget#workspaceHeader { background-color: @bg; border-bottom: 1px solid @border; }
QPushButton#workspaceStatus {
    color: @fgSecondary; background: transparent; border: 1px solid @border;
    border-radius: 13px; padding: 0px 11px 0px 9px; font-size: 12px; font-weight: 500;
}
QPushButton#workspaceStatus:hover {
    color: @fg; background-color: @surfaceRaised; border-color: @borderStrong;
}
QPushButton#workspaceStop, QPushButton#workspaceResume,
QPushButton#workspaceToggleChanges, QPushButton#workspaceOpenDiff {
    color: @fg; background-color: @surface; border: 1px solid @borderStrong;
    border-radius: 9px; padding: 0px 13px; font-size: 13px; font-weight: 500;
}
QPushButton#workspaceResume:hover, QPushButton#workspaceToggleChanges:hover,
QPushButton#workspaceOpenDiff:hover { background-color: @surfaceRaised; }
QPushButton#workspaceToggleChanges:checked { background-color: @surfaceRaised; }
QPushButton#workspaceToggleChanges:disabled { color: @fgSubtle; border-color: @border; }
QPushButton#workspaceStop:hover {
    color: @danger; background-color: @dangerSubtle; border-color: @danger;
}
#workspaceEmptyTitle { color: @fg; font-size: 20px; font-weight: 600; }
#workspaceEmptyBody { color: @fgMuted; font-size: 13px; }
QFrame#workspaceChangesCard {
    background-color: @bgSubtle; border: 1px solid @border; border-radius: 12px;
}
#workspaceChangesText { color: @fgMuted; font-size: 13px; background: transparent; }

QWidget#workspaceTerminalDock[workspaceNext="true"] { background-color: @bg; }
QWidget#workspacePanelBar { background-color: @bg; border-bottom: 1px solid @border; }
QPushButton#workspacePanelTab {
    color: @fgMuted; background: transparent; border: 1px solid transparent;
    border-radius: 9px; padding: 0px 12px; font-size: 13px; font-weight: 500;
}
QPushButton#workspacePanelTab:hover { color: @fg; background-color: @surfaceRaised; }
QPushButton#workspacePanelTab:checked {
    color: @fg; background-color: @surface; border-color: @borderStrong;
}
QPushButton#workspacePanelTab:disabled { color: @fgSubtle; background: transparent; }
#workspacePanelBranch { color: @fgSubtle; font-size: 12px; background: transparent; }
#workspacePanelStats { font-size: 13px; font-weight: 500; background: transparent; }
#workspaceEmptyTitle, #workspaceEmptyBody { background: transparent; }
QWidget#workspaceBrowserBar { background-color: @bg; border-bottom: 1px solid @border; }
QLineEdit#workspaceBrowserAddress {
    border-radius: 13px; padding: 3px 12px; font-size: 12px; background-color: @surface;
}
QPushButton#workspaceGhostButton {
    color: @fg; background-color: @surfaceRaised; border: 1px solid @borderStrong;
    border-radius: 6px; padding: 5px 12px; font-size: 12px; font-weight: 500;
}
QPushButton#workspaceGhostButton:hover { background-color: @surfaceActive; }

#promptWrapper[workspaceDocked="true"] {
    background-color: @bgSubtle; border: 1px solid @borderStrong; border-radius: 16px;
}
#promptWrapper[workspaceDocked="true"] > QWidget { background: transparent; }
#promptWrapper[workspaceDocked="true"] #issueQuickAdd {
    background: transparent; border: none; border-radius: 0px;
    padding: 14px 18px 4px 18px; font-size: 15px;
}
#promptWrapper[workspaceDocked="true"] #issueQuickAdd:focus { border: none; }
#promptWrapper[workspaceDocked="true"] #quickAddBottomBarScroll,
#promptWrapper[workspaceDocked="true"] #quickAddBottomBarHost {
    background: transparent; border: none;
}
QPushButton#workspaceSend {
    background-color: @surfaceActive; border: 1px solid @borderStrong;
    border-radius: 17px; padding: 0px;
}
QPushButton#workspaceSend:hover { background-color: @borderStrong; }
QPushButton#workspaceSend:pressed { background-color: @surfaceRaised; }
QPushButton#workspaceSend[workspaceChat="true"] {
    background-color: @accent; border-color: @accent; color: @onAccent;
    padding: 0px 10px; font-size: 12px; font-weight: 600;
}
QPushButton#workspaceSend[workspaceChat="true"]:hover { background-color: @accentHover; }
