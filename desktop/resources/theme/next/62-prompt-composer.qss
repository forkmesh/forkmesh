#promptWrapper {
    background-color: @surface; border: 1px solid @borderStrong; border-radius: 12px;
}
#promptWrapper > QWidget { background: transparent; }
#promptWrapper #quickAddBottomBarScroll,
#promptWrapper #quickAddBottomBarScroll > QWidget,
#promptWrapper #quickAddBottomBarHost,
#promptWrapper #quickAddAgentBox,
#promptWrapper #quickAddAttachStrip {
    background: transparent; border: none;
}

#promptWrapper #promptDragHandle { background: transparent; border: none; }
#promptWrapper QPushButton#promptClearButton,
#promptWrapper QPushButton#promptCloudButton,
#promptWrapper QPushButton#promptWorktreeCheck,
#promptWrapper QPushButton#promptVibeCheck,
#promptWrapper QPushButton#promptResetButton,
#promptWrapper QPushButton#promptDetachButton {
    background: transparent; border: 1px solid transparent; border-radius: 5px; padding: 0px;
}
#promptWrapper QPushButton#promptClearButton:hover,
#promptWrapper QPushButton#promptCloudButton:hover,
#promptWrapper QPushButton#promptWorktreeCheck:hover,
#promptWrapper QPushButton#promptVibeCheck:hover,
#promptWrapper QPushButton#promptResetButton:hover,
#promptWrapper QPushButton#promptDetachButton:hover { background-color: @surfaceRaised; }
#promptWrapper QPushButton#promptClearButton:pressed,
#promptWrapper QPushButton#promptCloudButton:pressed,
#promptWrapper QPushButton#promptWorktreeCheck:pressed,
#promptWrapper QPushButton#promptVibeCheck:pressed,
#promptWrapper QPushButton#promptResetButton:pressed,
#promptWrapper QPushButton#promptDetachButton:pressed { background-color: @surfaceActive; }
#promptWrapper QPushButton#promptCloudButton:checked,
#promptWrapper QPushButton#promptWorktreeCheck:checked,
#promptWrapper QPushButton#promptVibeCheck:checked {
    background-color: @accentSubtle; border-color: @accent;
}
#promptWrapper QLabel#promptChatPreview {
    background: transparent; border: none; border-bottom: 1px solid @border;
    padding: 0px; font-size: 11px; color: @fgMuted;
}

#promptWrapper #issueQuickAdd {
    background: transparent; border: none; border-radius: 0px;
    padding: 4px 12px; font-size: 13px; color: @fg;
}
#promptWrapper #issueQuickAdd:focus { border: none; }

#promptWrapper QPushButton#ghostButton {
    background: transparent; border: none; border-radius: 6px;
    padding: 0px 6px; color: @fgMuted; font-size: 12px; font-weight: 500;
}
#promptWrapper QPushButton#ghostButton:hover { background-color: @surfaceRaised; color: @fg; }
#promptWrapper QPushButton#ghostButton:pressed { background-color: @surfaceActive; }
#promptWrapper QPushButton#quickAddSlashButton {
    background: transparent; border: none; border-radius: 6px;
    padding: 0px; color: @fgMuted; font-size: 13px; font-weight: 500;
}
#promptWrapper QPushButton#quickAddSlashButton:hover { background-color: @surfaceRaised; color: @fg; }
#promptWrapper QPushButton#quickAddSlashButton:pressed { background-color: @surfaceActive; }

#promptWrapper QComboBox#quickAddAgentModelSelector,
#promptWrapper QComboBox#quickAddTaskAssignee,
#promptWrapper QComboBox#quickAddModeSelector,
#promptWrapper QComboBox#quickAddSpeedSelector {
    background-color: transparent; border: 1px solid transparent; border-radius: 6px;
    color: @fgSecondary; font-size: 12px; font-weight: 500;
}
#promptWrapper QComboBox#quickAddAgentModelSelector,
#promptWrapper QComboBox#quickAddTaskAssignee { padding: 0px 4px 0px 8px; }
#promptWrapper QComboBox#quickAddModeSelector { padding: 0px 8px 0px 6px; font-size: 12px; }
#promptWrapper QComboBox#quickAddSpeedSelector { padding: 0px 6px; }
#promptWrapper QComboBox#quickAddAgentModelSelector:hover,
#promptWrapper QComboBox#quickAddTaskAssignee:hover,
#promptWrapper QComboBox#quickAddModeSelector:hover,
#promptWrapper QComboBox#quickAddSpeedSelector:hover {
    background-color: @surfaceRaised; border-color: transparent; color: @fg;
}
#promptWrapper QComboBox#quickAddAgentModelSelector:focus,
#promptWrapper QComboBox#quickAddTaskAssignee:focus,
#promptWrapper QComboBox#quickAddModeSelector:focus,
#promptWrapper QComboBox#quickAddSpeedSelector:focus { border-color: transparent; }
#promptWrapper QComboBox#quickAddAgentModelSelector:on,
#promptWrapper QComboBox#quickAddTaskAssignee:on,
#promptWrapper QComboBox#quickAddModeSelector:on,
#promptWrapper QComboBox#quickAddSpeedSelector:on {
    background-color: @surfaceActive; border-color: transparent; color: @fg;
}
#promptWrapper QComboBox#quickAddAgentModelSelector::drop-down,
#promptWrapper QComboBox#quickAddTaskAssignee::drop-down {
    border: none; width: 16px; subcontrol-origin: padding; subcontrol-position: center right;
}
#promptWrapper QComboBox#quickAddAgentModelSelector::down-arrow,
#promptWrapper QComboBox#quickAddTaskAssignee::down-arrow {
    image: url(@chevronIcon); width: 12px; height: 12px;
}
#promptWrapper QComboBox#quickAddModeSelector::drop-down,
#promptWrapper QComboBox#quickAddSpeedSelector::drop-down { border: none; width: 0px; }
#promptWrapper QComboBox#quickAddModeSelector::down-arrow,
#promptWrapper QComboBox#quickAddSpeedSelector::down-arrow { image: none; width: 0px; height: 0px; }

#promptWrapper QPushButton#quickAddGenieButton {
    background: transparent; border: 1px solid transparent; border-radius: 6px;
    padding: 0px 8px; color: @fgMuted; font-size: 12px; font-weight: 500;
}
#promptWrapper QPushButton#quickAddGenieButton:hover { background-color: @surfaceRaised; color: @fg; }
#promptWrapper QPushButton#quickAddGenieButton:pressed { background-color: @surfaceActive; }
#promptWrapper QPushButton#quickAddSendIcon {
    background-color: @surfaceRaised; border: 1px solid @borderStrong; border-radius: 6px;
    padding: 0px 8px; color: @fgSecondary; font-size: 12px; font-weight: 500;
}
#promptWrapper QPushButton#quickAddSendIcon:hover {
    background-color: @surfaceActive; border-color: @borderStrong; color: @fg;
}
#promptWrapper QPushButton#quickAddSendIcon:pressed { background-color: @surface; }
#promptWrapper QPushButton#quickAddSendIcon[enterTarget="true"] {
    background-color: @accent; border-color: @accent; color: @onAccent; font-weight: 600;
}
#promptWrapper QPushButton#quickAddSendIcon[enterTarget="true"]:hover {
    background-color: @accentHover; border-color: @accentHover; color: @onAccent;
}
#promptWrapper QPushButton#quickAddSendIcon[enterTarget="true"]:pressed {
    background-color: @accentPressed; border-color: @accentPressed;
}
#promptWrapper QPushButton#quickAddSendIcon:disabled,
#promptWrapper QPushButton#quickAddGenieButton:disabled {
    background-color: transparent; border-color: @border; color: @fgSubtle;
}
