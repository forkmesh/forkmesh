QToolTip {
    background-color: @surfaceRaised; color: @fg;
    border: 1px solid @borderStrong; padding: 5px 8px;
}

QCheckBox::indicator {
    width: 14px; height: 14px; border-radius: 4px;
    border: 1px solid @borderStrong; background: @surface;
}
QCheckBox::indicator:hover { border-color: @fgSubtle; }
QCheckBox::indicator:checked {
    border-color: @accent; background: @accent; image: url(@checkIcon);
}
QCheckBox::indicator:checked:hover { border-color: @accentHover; background: @accentHover; }
QCheckBox::indicator:disabled { background: @surfaceRaised; border-color: @border; }
QRadioButton::indicator {
    width: 14px; height: 14px; border-radius: 8px;
    border: 1px solid @borderStrong; background: @surface;
}
QRadioButton::indicator:hover { border-color: @fgSubtle; }
QRadioButton::indicator:checked {
    width: 6px; height: 6px; border: 5px solid @accent; background: @onAccent;
}

QLineEdit, QSpinBox, QComboBox {
    background-color: @surface; border: 1px solid @borderStrong;
    border-radius: 8px;
    selection-background-color: @selection; selection-color: @fg;
}
QComboBox { combobox-popup: 0; }
QComboBox::drop-down {
    subcontrol-origin: padding; subcontrol-position: center right;
    border: none; width: 24px;
}
QComboBox::down-arrow { image: url(@chevronIcon); width: 12px; height: 12px; }
QComboBox:on { border-color: @accent; }
QLineEdit:hover, QSpinBox:hover, QComboBox:hover { border-color: @fgSubtle; }
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: @accent; }
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled {
    color: @fgSubtle; background-color: @surfaceRaised; border-color: @border;
}
QTextEdit, QPlainTextEdit, QTextBrowser {
    selection-background-color: @selection; selection-color: @fg;
}
QCheckBox#promptVibeCheck::indicator:checked,
QCheckBox#promptWorktreeCheck::indicator:checked,
QCheckBox#quickAddAgentCheck::indicator:checked,
QCheckBox#quickAddCreateIssueCheck::indicator:checked,
QCheckBox#slashToggle::indicator:checked { image: none; }
QComboBoxPrivateContainer { background: transparent; border: none; padding: 4px 0px; }
QComboBoxPrivateContainer[floatingSurface="false"] { background-color: @bg; }
QComboBox QAbstractItemView {
    background-color: @surface; border: 1px solid @borderStrong; border-radius: 10px;
    padding: 4px; outline: none; color: @fg;
    selection-background-color: @surfaceActive; selection-color: @fg;
}
QComboBoxPrivateContainer[floatingSurface="false"] QAbstractItemView { border-radius: 0px; }
QComboBox QAbstractItemView::item {
    min-height: 28px; padding: 0px 10px; border: none; border-radius: 6px;
    color: @fgSecondary; background: transparent;
}
QComboBox QAbstractItemView::item:hover { background-color: @surfaceRaised; color: @fg; }
QComboBox QAbstractItemView::item:selected { background-color: @surfaceActive; color: @fg; }
QComboBox QAbstractItemView::item:disabled { color: @fgSubtle; }

QPushButton {
    background-color: @surfaceRaised; border: 1px solid @borderStrong;
    border-radius: 8px; color: @fg; font-weight: 500;
}
QPushButton:hover { background-color: @surfaceActive; }
QPushButton:pressed { background-color: @surface; }
QPushButton:disabled { color: @fgSubtle; border-color: @border; }
QPushButton[activityToggle="true"] { color: @fgMuted; }
QPushButton[activityToggle="true"]:checked {
    background-color: @accentSubtle; border-color: @accent; color: @fg;
}
QPushButton[activityToggle="true"]:checked:hover { background-color: @accentSubtle; }
QPushButton[buttonSize="sm"] { border-radius: 6px; }
QPushButton[buttonSize="xs"] { border-radius: 5px; }

QPushButton#primaryButton {
    background-color: @accent; border: 1px solid @accent;
    color: @onAccent; font-weight: 600;
}
QPushButton#primaryButton:hover { background-color: @accentHover; border-color: @accentHover; }
QPushButton#primaryButton:pressed { background-color: @accentPressed; border-color: @accentPressed; }
QPushButton#primaryButton:disabled {
    background-color: @surfaceRaised; color: @fgSubtle; border-color: @border;
}
QPushButton#ghostButton { color: @fgMuted; border-radius: 6px; }
QPushButton#ghostButton:hover { color: @fg; background-color: @surfaceRaised; }
QPushButton#dangerButton {
    background: transparent; border: 1px solid @borderStrong;
    border-radius: 8px; color: @danger; font-weight: 500;
}
QPushButton#dangerButton:hover {
    background-color: @danger; border-color: @danger; color: @onAccent;
}
QPushButton#successButton {
    background: transparent; border: 1px solid @borderStrong;
    border-radius: 8px; color: @success; font-weight: 500;
}
QPushButton#successButton:hover {
    background-color: @success; border-color: @success; color: @onAccent;
}
#iconButton:hover { background-color: @surfaceRaised; border-radius: 6px; }
QPushButton#repoAction {
    background-color: @surfaceRaised; border: 1px solid @borderStrong;
    border-radius: 6px; font-weight: 500;
}
QPushButton#repoAction:hover { background-color: @surfaceActive; }

QScrollBar::handle:vertical {
    background: @borderStrong; border-radius: 3px; min-height: 30px; margin: 2px;
}
QScrollBar::handle:vertical:hover { background: @fgSubtle; }
QScrollBar::handle:horizontal {
    background: @borderStrong; border-radius: 3px; min-width: 30px; margin: 2px;
}
QScrollBar::handle:horizontal:hover { background: @fgSubtle; }

QSplitter::handle:horizontal {
    width: 9px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 transparent, stop:0.44 transparent, stop:0.45 @border,
        stop:0.55 @border, stop:0.56 transparent, stop:1 transparent);
}
QSplitter::handle:vertical {
    height: 9px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 transparent, stop:0.44 transparent, stop:0.45 @border,
        stop:0.55 @border, stop:0.56 transparent, stop:1 transparent);
}
QSplitter::handle:horizontal:hover, QSplitter::handle:horizontal:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 transparent, stop:0.33 transparent, stop:0.34 @accent,
        stop:0.66 @accent, stop:0.67 transparent, stop:1 transparent);
}
QSplitter::handle:vertical:hover, QSplitter::handle:vertical:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 transparent, stop:0.33 transparent, stop:0.34 @accent,
        stop:0.66 @accent, stop:0.67 transparent, stop:1 transparent);
}

QMenu {
    background-color: @surface; border: 1px solid @borderStrong;
    border-radius: 10px; padding: 5px; color: @fg;
}
QMenu[floatingSurface="false"], #agentMetaPopup[floatingSurface="false"],
#reactionPicker[floatingSurface="false"], #slashActionsPopup[floatingSurface="false"],
#globalSearchPopup[floatingSurface="false"], #mentionPopup[floatingSurface="false"] {
    border-radius: 0px;
}
QMenu::item {
    padding: 7px 28px 7px 12px; border-radius: 6px; color: @fgSecondary;
    background: transparent;
}
QMenu::item:selected { background-color: @surfaceActive; color: @fg; }
QMenu::item:disabled { color: @fgSubtle; background: transparent; }
QMenu::icon { padding-left: 10px; }
QMenu::indicator { width: 14px; height: 14px; left: 8px; }
QMenu::indicator:non-exclusive:checked, QMenu::indicator:exclusive:checked {
    image: url(@menuCheckIcon);
}
QMenu::item:checked { color: @fg; }
QMenu::right-arrow { image: url(@chevronRightIcon); width: 12px; height: 12px; right: 8px; }
QMenu::separator { height: 1px; background: @border; margin: 5px 4px; }

QHeaderView { background-color: transparent; border: none; }
QHeaderView::section {
    background-color: transparent; color: @fgMuted; border: none;
    border-bottom: 1px solid @border; padding: 8px 12px;
    font-size: 12px; font-weight: 500;
}
QHeaderView::section:vertical {
    color: @fgSubtle; border-bottom: none; border-right: 1px solid @border;
    padding: 0px 8px;
}
QTableCornerButton::section {
    background-color: @bg; border: none; border-bottom: 1px solid @border;
    border-right: 1px solid @border;
}
QTableView, QTableWidget {
    gridline-color: @border; alternate-background-color: @bgSubtle;
    selection-background-color: @accentSubtle; selection-color: @fg;
    outline: none;
}
QTableView::item:selected, QTableWidget::item:selected {
    background-color: @accentSubtle; color: @fg;
}

QTableView[dataTable="true"] {
    background-color: @bg; alternate-background-color: @bg;
    border: 1px solid @border; border-radius: 8px; outline: none;
}
QTableView[dataTable="true"]::item {
    padding: 0px 12px; border: none; border-bottom: 1px solid @border;
    color: @fgSecondary;
}
QTableView[dataTable="true"]::item:hover {
    background-color: @surfaceRaised; color: @fg;
}
QTableView[dataTable="true"]::item:selected,
QTableView[dataTable="true"]::item:selected:hover {
    background-color: @accentSubtle; color: @fg;
}
QTableView[dataTable="true"] QHeaderView::section {
    background-color: transparent; color: @fgMuted; border: none;
    border-bottom: 1px solid @border; padding: 9px 12px;
    font-size: 12px; font-weight: 500;
}

QTabWidget::pane { border: none; border-top: 1px solid @border; }
QTabBar::tab {
    background: transparent; color: @fgMuted; padding: 7px 12px;
    border: none; border-bottom: 2px solid transparent;
}
QTabBar::tab:hover { color: @fg; }
QTabBar::tab:selected { color: @fg; border-bottom: 2px solid @accentFg; }
QTabBar::close-button {
    image: url(@closeIcon); subcontrol-position: right;
    width: 14px; height: 14px; padding: 2px; margin: 0px 4px 0px 2px;
    border-radius: 4px; background: transparent;
}
QTabBar::close-button:hover { image: url(@closeHoverIcon); background-color: @surfaceActive; }
QTabBar::scroller { width: 44px; }
QTabBar QToolButton {
    background-color: @bg; border: none; border-radius: 6px; color: @fgMuted;
}
QTabBar QToolButton:hover { background-color: @surfaceRaised; color: @fg; }

QProgressBar {
    background-color: @surfaceActive; border: none; border-radius: 3px;
    color: @fgMuted; text-align: center;
}
QProgressBar::chunk { background-color: @accent; border-radius: 3px; }

QSlider::groove:horizontal { height: 4px; background: @surfaceActive; border-radius: 2px; }
QSlider::sub-page:horizontal { background: @accent; border-radius: 2px; }
QSlider::handle:horizontal {
    width: 12px; height: 12px; margin: -6px 0; border-radius: 8px;
    background: @bg; border: 2px solid @accent;
}
QSlider::handle:horizontal:hover { border-color: @accentHover; }

#sectionLabel { color: @fgMuted; font-size: 12px; font-weight: 500; letter-spacing: 0px; }
#statusLine { color: @fgMuted; }

#card, #cardGroup {
    background-color: @surface; border: 1px solid @border; border-radius: 12px;
}
#card QLabel, #cardGroup QLabel, #settingsRow QLabel { background: transparent; }
#settingsRow { background: transparent; border: none; border-top: 1px solid @border; }
#settingsRow[firstRow="true"] { border-top: none; }
#settingsRowTitle { color: @fg; font-size: 14px; font-weight: 500; }
#settingsRowDescription { color: @fgMuted; font-size: 12px; }
#groupHeading { color: @fgSecondary; font-size: 14px; font-weight: 500; background: transparent; }
#pageTitle { color: @fg; font-size: 20px; font-weight: 600; background: transparent; }
#pageLede { color: @fgMuted; font-size: 14px; background: transparent; }
#fieldLabel { color: @fg; font-size: 13px; font-weight: 500; background: transparent; }
#fieldHint { color: @fgMuted; font-size: 12px; background: transparent; }

#badge {
    border-radius: 6px; padding: 1px 6px; font-size: 11px; font-weight: 500;
    color: @fgSecondary; background-color: @surfaceRaised; border: 1px solid @borderStrong;
}
#badge[tone="accent"] { color: @accentFg; background-color: @accentSubtle; border-color: @accentSubtle; }
#badge[tone="success"] { color: @success; background-color: @successSubtle; border-color: @successSubtle; }
#badge[tone="warning"] { color: @warning; background-color: @warningSubtle; border-color: @warningSubtle; }
#badge[tone="danger"] { color: @danger; background-color: @dangerSubtle; border-color: @dangerSubtle; }
#badge[outline="true"] { background-color: transparent; border-color: @borderStrong; }
#badge[outline="true"][tone="warning"] { border-color: @warning; }
#badge[outline="true"][tone="danger"] { border-color: @danger; }
#badge[outline="true"][tone="success"] { border-color: @success; }
#badge[outline="true"][tone="accent"] { border-color: @accent; }

#keyHint {
    color: @fgSecondary; background-color: @surfaceRaised;
    border: 1px solid @borderStrong; border-radius: 4px;
    padding: 0px 5px; font-size: 11px; font-weight: 500;
}

#inlineNotice {
    background-color: @surfaceRaised; border: 1px solid @borderStrong; border-radius: 8px;
}
#inlineNotice QLabel { background: transparent; color: @fgSecondary; font-size: 12px; }
#inlineNotice[tone="danger"] { background-color: @dangerSubtle; border-color: @danger; }
#inlineNotice[tone="danger"] QLabel { color: @danger; }
#inlineNotice[tone="warning"] { background-color: @warningSubtle; border-color: @warning; }
#inlineNotice[tone="warning"] QLabel { color: @warning; }
#inlineNotice[tone="success"] { background-color: @successSubtle; border-color: @success; }
#inlineNotice[tone="success"] QLabel { color: @success; }
#inlineNotice[tone="accent"] { background-color: @accentSubtle; border-color: @accent; }
#inlineNotice[tone="accent"] QLabel { color: @accentFg; }

#emptyState, #emptyState QLabel { background: transparent; }
#emptyStateTitle { color: @fg; font-size: 14px; font-weight: 500; }
#emptyStateBody { color: @fgMuted; font-size: 12px; }

#segmentedControl {
    background-color: @surfaceRaised; border: 1px solid @border; border-radius: 8px;
}
QPushButton#segmentedButton {
    background: transparent; border: 1px solid transparent; border-radius: 6px;
    color: @fgMuted; font-size: 12px; font-weight: 500; padding: 3px 10px;
}
QPushButton#segmentedButton:hover { color: @fg; }
QPushButton#segmentedButton:checked {
    background-color: @bg; border-color: @borderStrong; color: @fg;
}
